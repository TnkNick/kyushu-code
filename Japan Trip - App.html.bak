<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>WWN · Japan Trip</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Trirong:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Noto+Serif+Thai:wght@400;500;600;700&family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&family=Hanken+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet" />
<style>
  /* ───────────────────────── reset ───────────────────────── */
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    background: #0e0b07;
    font-family: "Sukhumvit Set", "IBM Plex Sans Thai", "Hanken Grotesk", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  #root { height: 100%; }
  button { font-family: inherit; cursor: pointer; color: inherit; }
  a { color: inherit; }

  /* ───────────────────────── theme tokens ───────────────────────── */
  .lookbook {
    --sans: "Sukhumvit Set", "IBM Plex Sans Thai", "Hanken Grotesk", system-ui, sans-serif;
    --serif: "Sukhumvit Set", "IBM Plex Sans Thai", "Hanken Grotesk", system-ui, sans-serif;
    --scale: 1;
    height: 100%;
    font-family: var(--sans);
    background: var(--paper);
    color: var(--ink);
    position: relative;
    background-image: var(--grain, none);
    background-attachment: fixed;
    transition: background-color .9s ease, color .9s ease;
  }
  /* Kurogane — warm espresso black, brass & ember: the dark hero (default) */
  .lookbook[data-theme="kurogane"] {
    --paper: #14100b; --paper-2: #1f1810; --ink: #f2e7d5; --ink-soft: #b2a288;
    --taupe: #c5a06a; --sand: #2a2018; --accent: #d9aa5c; --accent-2: #d06a3e;
    --line: rgba(242,231,213,.16); --line-soft: rgba(242,231,213,.07); --chip: rgba(217,170,92,.12);
    --grain: radial-gradient(130% 90% at 82% -15%, rgba(217,170,92,.20), transparent 55%),
             radial-gradient(120% 95% at -12% 112%, rgba(208,106,62,.16), transparent 50%);
  }
  /* Sumi — cool charcoal ink & champagne: monochrome dark, restrained */
  .lookbook[data-theme="sumi"] {
    --paper: #101113; --paper-2: #191b1e; --ink: #ece9e3; --ink-soft: #989a98;
    --taupe: #b9ac90; --sand: #23262a; --accent: #cbbb95; --accent-2: #8ea0b4;
    --line: rgba(236,233,227,.15); --line-soft: rgba(236,233,227,.07); --chip: rgba(203,187,149,.10);
    --grain: radial-gradient(130% 90% at 82% -15%, rgba(203,187,149,.13), transparent 55%),
             radial-gradient(120% 95% at -12% 112%, rgba(142,160,180,.13), transparent 50%);
  }
  /* Urushi — deep lacquer oxblood & gold: dark and opulent */
  .lookbook[data-theme="urushi"] {
    --paper: #160c0b; --paper-2: #231311; --ink: #f1e3d9; --ink-soft: #bd9c8f;
    --taupe: #c79a55; --sand: #2c1612; --accent: #cda35a; --accent-2: #b8463a;
    --line: rgba(241,227,217,.15); --line-soft: rgba(241,227,217,.07); --chip: rgba(184,70,58,.14);
    --grain: radial-gradient(130% 90% at 82% -15%, rgba(205,163,90,.17), transparent 55%),
             radial-gradient(120% 95% at -12% 112%, rgba(184,70,58,.22), transparent 50%);
  }

  /* Hisui — dark jade & gold: cool, green, garden-like (Day 02) */
  .lookbook[data-theme="hisui"] {
    --paper: #0c1411; --paper-2: #12201a; --ink: #e8efe7; --ink-soft: #92a89b;
    --taupe: #7fa48c; --sand: #18261f; --accent: #5fae86; --accent-2: #c9a44e;
    --line: rgba(232,239,231,.16); --line-soft: rgba(232,239,231,.07); --chip: rgba(95,174,134,.12);
    --grain: radial-gradient(130% 90% at 82% -15%, rgba(95,174,134,.18), transparent 55%),
             radial-gradient(120% 95% at -12% 112%, rgba(201,164,78,.14), transparent 50%);
  }

  /* Ai — indigo & moonlit silver: cool night blue (Nara · Fuji) */
  .lookbook[data-theme="ai"] {
    --paper: #0b0f17; --paper-2: #121828; --ink: #e7ecf5; --ink-soft: #8e9ab4;
    --taupe: #7e8db0; --sand: #161d2e; --accent: #6d8fd6; --accent-2: #b9a06a;
    --line: rgba(231,236,245,.16); --line-soft: rgba(231,236,245,.07); --chip: rgba(109,143,214,.13);
    --grain: radial-gradient(130% 90% at 82% -15%, rgba(109,143,214,.20), transparent 55%),
             radial-gradient(120% 95% at -12% 112%, rgba(185,160,106,.13), transparent 50%);
  }
  /* Kohaku — amber & ember: warm Osaka neon (Osaka) */
  .lookbook[data-theme="kohaku"] {
    --paper: #160f08; --paper-2: #23170c; --ink: #f4e7d2; --ink-soft: #bb9f7c;
    --taupe: #cf9a52; --sand: #2a1c0e; --accent: #e08a3c; --accent-2: #d6543a;
    --line: rgba(244,231,210,.16); --line-soft: rgba(244,231,210,.07); --chip: rgba(224,138,60,.14);
    --grain: radial-gradient(130% 90% at 82% -15%, rgba(224,138,60,.22), transparent 55%),
             radial-gradient(120% 95% at -12% 112%, rgba(214,84,58,.16), transparent 50%);
  }
  /* Botan — peony plum & rose-gold: deep magenta (Tokyo east) */
  .lookbook[data-theme="botan"] {
    --paper: #140a12; --paper-2: #20111d; --ink: #f3e3ee; --ink-soft: #bd96b0;
    --taupe: #c089a8; --sand: #281320; --accent: #c45c93; --accent-2: #cc9a5a;
    --line: rgba(243,227,238,.16); --line-soft: rgba(243,227,238,.07); --chip: rgba(196,92,147,.14);
    --grain: radial-gradient(130% 90% at 82% -15%, rgba(196,92,147,.20), transparent 55%),
             radial-gradient(120% 95% at -12% 112%, rgba(204,154,90,.14), transparent 50%);
  }

  /* image-slot framing */
  .img-frame { position: relative; overflow: hidden; background: var(--paper-2); }
  .img-frame image-slot { transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .img-edge { position: absolute; inset: 0; box-shadow: inset 0 0 0 1px var(--line-soft); pointer-events: none; }
  .img-kicker {
    position: absolute; left: 14px; top: 14px; z-index: 2;
    font-size: 10px; letter-spacing: .22em; text-transform: uppercase; font-weight: 500;
    color: #f7f4ee; background: rgba(20,18,15,.42); backdrop-filter: blur(6px);
    padding: 5px 10px; border: .5px solid rgba(255,255,255,.18);
  }
  .no-images .img-frame image-slot { opacity: 0; }
  .no-images .img-frame { background:
      repeating-linear-gradient(45deg, var(--paper-2), var(--paper-2) 11px, transparent 11px, transparent 22px); }

  /* ───────────────────────── AMBIENT ANIMATED BACKGROUND ───────────────────────── */
  .bg-fx { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .view-cover, .view-itinerary { position: relative; z-index: 1; }
  .bg-fx .orb { position: absolute; border-radius: 50%; filter: blur(64px); opacity: .42;
    mix-blend-mode: screen; will-change: transform; }
  .bg-fx .orb-1 { width: 48vw; height: 48vw; left: -10vw; top: -12vh;
    background: radial-gradient(circle at 50% 50%, var(--accent), transparent 68%);
    animation: drift1 36s ease-in-out infinite alternate; }
  .bg-fx .orb-2 { width: 42vw; height: 42vw; right: -12vw; top: 16vh;
    background: radial-gradient(circle at 50% 50%, var(--accent-2), transparent 70%);
    animation: drift2 46s ease-in-out infinite alternate; }
  .bg-fx .orb-3 { width: 36vw; height: 36vw; left: 30vw; bottom: -18vh;
    background: radial-gradient(circle at 50% 50%, var(--taupe), transparent 72%);
    animation: drift3 54s ease-in-out infinite alternate; }
  .bg-grain { position: absolute; inset: 0;
    background: radial-gradient(125% 125% at 50% 38%, transparent 52%, rgba(0,0,0,.55) 100%); }
  @keyframes drift1 { from { transform: translate3d(0,0,0) scale(1); } to { transform: translate3d(8vw,9vh,0) scale(1.18); } }
  @keyframes drift2 { from { transform: translate3d(0,0,0) scale(1.1); } to { transform: translate3d(-9vw,7vh,0) scale(.92); } }
  @keyframes drift3 { from { transform: translate3d(0,0,0) scale(.95); } to { transform: translate3d(6vw,-8vh,0) scale(1.2); } }
  .no-bgfx .bg-fx { display: none; }
  /* keep chrome legible over the glow */
  .chrome, .stage-foot { transition: background-color .9s ease; }

  /* ───────────────────────── COVER ───────────────────────── */
  .view-cover { height: 100%; animation: coverIn 1s ease both; }
  .view-cover.leaving { animation: coverOut .54s cubic-bezier(.6,0,.4,1) forwards; }
  @keyframes coverIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes coverOut { to { opacity: 0; transform: scale(1.04); } }

  .cover { position: relative; height: 100%; overflow: hidden; }
  .cover-bg { position: absolute; inset: 0; }
  .cover-img.img-frame { position: absolute; inset: 0; height: 100%; width: 100%; background: #2a2722; }
  .cover-img image-slot { animation: kenburns 22s ease-in-out infinite alternate; }
  @keyframes kenburns { from { transform: scale(1.02); } to { transform: scale(1.12); } }
  .cover-veil { position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(12,11,9,.46) 0%, rgba(12,11,9,.12) 32%, rgba(12,11,9,.18) 64%, rgba(12,11,9,.74) 100%); }

  .cover-inner { position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column;
    justify-content: space-between; padding: clamp(28px, 5vw, 64px); color: #f6f2ea; }
  .cover-top { display: flex; justify-content: space-between; align-items: center;
    animation: rise .9s .1s ease both; }
  .wordmark { display: inline-flex; align-items: center; gap: 9px; font-size: 15px; letter-spacing: .14em;
    text-transform: uppercase; font-weight: 500; }
  .cover-origin { font-size: 11px; letter-spacing: .24em; text-transform: uppercase; opacity: .72; }

  .cover-center { margin-top: auto; margin-bottom: auto; }
  .cover-kicker { display: block; font-size: clamp(11px,1.1vw,13px); letter-spacing: .34em;
    text-transform: uppercase; font-weight: 500; color: var(--sand); margin-bottom: clamp(14px,2vw,26px);
    animation: rise 1s .25s ease both; }
  .cover-title { font-family: var(--serif); font-weight: 500; line-height: .86; letter-spacing: -.02em;
    font-size: calc(clamp(82px, 16vw, 248px) * var(--scale)); animation: rise 1.1s .35s ease both; }
  .cover-subtitle { font-family: var(--serif); font-style: italic; font-weight: 400;
    font-size: clamp(20px, 2.6vw, 34px); margin-top: clamp(10px,1.4vw,20px); color: #efe9df;
    animation: rise 1.1s .5s ease both; }

  .cover-bottom { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px;
    flex-wrap: wrap; animation: rise 1s .65s ease both; }
  .cover-dates { display: inline-flex; align-items: center; gap: 10px; font-size: 14px;
    letter-spacing: .12em; text-transform: uppercase; }
  .cover-enter { display: inline-flex; align-items: center; gap: 16px; background: transparent;
    border: none; color: #f6f2ea; font-size: 13px; letter-spacing: .2em; text-transform: uppercase;
    font-weight: 500; padding: 6px 0; position: relative; }
  .cover-enter::after { content: ""; position: absolute; left: 0; bottom: 0; height: 1px; width: calc(100% - 64px);
    background: rgba(246,242,234,.5); transition: width .4s ease; }
  .cover-enter:hover::after { width: 100%; }
  .cover-enter-i { display: inline-grid; place-items: center; width: 46px; height: 46px; border-radius: 50%;
    border: 1px solid rgba(246,242,234,.45); transition: background .35s, color .35s, transform .35s; }
  .cover-enter:hover .cover-enter-i { background: #f6f2ea; color: #1a1815; transform: translateX(4px); }

  @keyframes rise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }

  /* ───────────────────────── ITINERARY SHELL ───────────────────────── */
  /* ═══════════════════════ OVERVIEW (destination presentation) ═══════════════════════ */
  .view-overview { height: 100%; animation: coverIn .7s ease both; }
  .overview { height: 100%; display: flex; flex-direction: column; }
  .ov-stage { flex: 1; overflow-y: auto; scroll-behavior: smooth; }
  .ov-kicker { display: inline-flex; align-items: center; gap: 13px; font-size: clamp(10px,1vw,12px);
    letter-spacing: .3em; text-transform: uppercase; font-weight: 600; color: var(--accent); }
  .ov-kicker::before { content: ""; width: 28px; height: 1px; background: var(--accent-2); flex: none; }
  .ov-h2 { font-weight: 700; letter-spacing: -.02em; line-height: 1.04; margin-top: 14px;
    font-size: calc(clamp(28px,4vw,52px) * var(--scale)); }

  /* hero */
  .ov-hero { position: relative; max-width: 1100px; margin: 0 auto; padding: clamp(48px,9vh,120px) clamp(22px,4vw,56px) clamp(40px,6vw,72px);
    display: flex; flex-direction: column; align-items: flex-start; overflow: hidden; }
  .ov-native { position: absolute; right: -2vw; top: 50%; transform: translateY(-50%);
    font-size: clamp(180px, 34vw, 460px); line-height: .8; font-weight: 700; color: var(--ink);
    opacity: .05; pointer-events: none; user-select: none; z-index: 0;
    animation: ovNative 1.6s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes ovNative { from { opacity: 0; transform: translate(4vw,-50%) scale(1.05); } to { opacity: .05; transform: translateY(-50%); } }
  .ov-hero > * { position: relative; z-index: 1; }
  .ov-hero .ov-kicker { animation: rise 1s .15s ease both; }
  .ov-country { font-weight: 700; letter-spacing: -.03em; line-height: .9; margin-top: 16px;
    font-size: calc(clamp(64px,13vw,184px) * var(--scale)); animation: rise 1.1s .28s ease both; }
  .ov-tagline { font-size: clamp(17px,1.9vw,24px); line-height: 1.5; color: var(--ink-soft); max-width: 40ch;
    margin-top: clamp(14px,2vw,22px); text-wrap: pretty; animation: rise 1.1s .42s ease both; }
  .ov-facts { display: flex; flex-wrap: wrap; gap: clamp(20px,3vw,52px); margin-top: clamp(26px,4vw,46px);
    padding-top: clamp(20px,3vw,30px); border-top: 1px solid var(--line); width: 100%; }
  .ov-fact { display: flex; flex-direction: column; gap: 7px; animation: rise .9s ease both;
    animation-delay: calc(.5s + var(--i) * .08s); }
  .ov-fact-k { font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-soft); }
  .ov-fact-v { font-size: clamp(16px,1.6vw,20px); font-weight: 600; }
  .lookbook[data-lang="th"] .ov-fact-k { letter-spacing: normal; text-transform: none; font-size: 12px; }

  /* dual clock panel */
  .clock-panel { display: inline-flex; align-items: stretch; gap: clamp(18px,2.6vw,38px); margin-top: clamp(26px,4vw,44px);
    padding: clamp(16px,2vw,22px) clamp(20px,2.6vw,32px); border: 1px solid var(--line); border-radius: 4px;
    background: color-mix(in srgb, var(--paper-2) 60%, transparent); animation: rise 1s .7s ease both; }
  .clock-cell { display: flex; flex-direction: column; gap: 8px; }
  .clock-cell-zone { font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; font-weight: 600; color: var(--ink-soft); }
  .lookbook[data-lang="th"] .clock-cell-zone { letter-spacing: normal; text-transform: none; font-size: 12.5px; }
  .clock-cell-time { font-size: clamp(26px,3.4vw,40px); font-weight: 600; line-height: 1; color: var(--ink);
    font-variant-numeric: tabular-nums; letter-spacing: .01em; }
  .clock-div { width: 1px; background: var(--line); flex: none; }

  /* route */
  .ov-route-sec, .party { max-width: 1100px; margin: 0 auto; padding: clamp(34px,5vw,64px) clamp(22px,4vw,56px);
    border-top: 1px solid var(--line); width: 100%; }
  .ov-route-head { margin-bottom: clamp(26px,4vw,44px); }
  /* visual journey map (Overview) */
  .jmap { position: relative; width: 100%; max-width: 860px; margin: 6px auto 0; aspect-ratio: 16 / 9; overflow: visible; }
  .jmap-native { position: absolute; inset: 0; display: grid; place-items: center; line-height: 1;
    font-size: clamp(130px,24vw,300px); font-weight: 700; color: var(--ink); opacity: .045;
    pointer-events: none; user-select: none; }
  .jmap-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .jmap-path { stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 100; stroke-dashoffset: 100; opacity: .5;
    transition: stroke-dashoffset 2.1s cubic-bezier(.4,.55,.2,1) .25s; }
  .jmap.in .jmap-path { stroke-dashoffset: 0; }
  .jmap-node { position: absolute; transform: translate(-50%,-50%); background: none; border: none; padding: 0;
    opacity: 0; transition: opacity .55s ease; transition-delay: calc(var(--i)*.16s + .35s); }
  .jmap.in .jmap-node { opacity: 1; }
  .jmap-dot { position: relative; display: block; width: clamp(44px,5.6vw,60px); height: clamp(44px,5.6vw,60px);
    border-radius: 50%; overflow: hidden; transition: transform .3s, box-shadow .3s;
    box-shadow: 0 0 0 2px var(--paper), 0 0 0 3.5px var(--accent), 0 10px 22px -8px rgba(0,0,0,.45); }
  .jmap-node:hover .jmap-dot { transform: scale(1.09);
    box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px var(--accent), 0 14px 28px -8px rgba(0,0,0,.55); }
  .jmap-label { position: absolute; top: calc(100% + 7px); left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 1px; white-space: nowrap; pointer-events: none; }
  .jmap-city { font-family: var(--serif); font-size: clamp(14px,1.5vw,17px); font-weight: 600; letter-spacing: -.01em; }
  .jmap-days { font-size: 11px; font-weight: 500; color: var(--ink-soft); letter-spacing: .03em; }
  .no-anim .jmap-path { transition: none; stroke-dashoffset: 0; }
  .no-anim .jmap-node { opacity: 1; transition: none; }
  @media (max-width: 560px) {
    .jmap { aspect-ratio: 1 / 1; }
    .jmap-days { display: none; }
    .jmap-dot { width: 38px; height: 38px; }
    .jmap-city { font-size: 12px; }
    .jmap-native { font-size: clamp(120px,40vw,200px); }
  }

  /* before-you-fly checklist */
  .pack-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%,250px),1fr)); gap: clamp(22px,3.5vw,48px); }
  .pack-group-label { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; color: var(--accent); margin-bottom: 10px; }
  .lookbook[data-lang="th"] .pack-group-label { letter-spacing: normal; text-transform: none; font-size: 13px; }
  .pack-list { list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .pack-item { display: flex; align-items: center; gap: 13px; width: 100%; text-align: left; background: none;
    border: none; padding: 9px 8px; border-radius: 9px; color: var(--ink); transition: background .2s; }
  .pack-item:hover { background: var(--chip); }
  .pack-check { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 6px;
    border: 1.5px solid var(--line); color: transparent; flex: none; transition: background .22s, border-color .22s; }
  .pack-check svg { opacity: 0; transform: scale(.4); transition: opacity .2s, transform .2s; }
  .pack-item.on .pack-check { background: var(--accent); border-color: var(--accent); color: var(--paper); }
  .pack-item.on .pack-check svg { opacity: 1; transform: none; }
  .pack-label { font-size: 14.5px; line-height: 1.35; transition: color .2s; }
  .pack-item.on .pack-label { color: var(--ink-soft); text-decoration: line-through; text-decoration-color: var(--line); }

  /* useful phrases */
  .phrase-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%,210px),1fr)); gap: clamp(10px,1.4vw,14px); }
  .phrase { border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; background: var(--paper-2);
    display: flex; flex-direction: column; gap: 4px; opacity: 0; transform: translateY(14px);
    transition: opacity .5s ease, transform .5s ease, border-color .25s ease; transition-delay: calc(var(--i)*.05s); }
  .party.in .phrase { opacity: 1; transform: none; }
  .phrase:hover { border-color: var(--accent); }
  .phrase-jp { font-family: var(--serif); font-size: clamp(20px,2.2vw,26px); font-weight: 600; letter-spacing: -.01em; line-height: 1.1; }
  .phrase-romaji { font-size: 13px; font-weight: 600; color: var(--accent); letter-spacing: .02em; }
  .phrase-mean { font-size: 13.5px; color: var(--ink-soft); }
  .no-anim .phrase { opacity: 1; transform: none; transition: none; }

  .route { position: relative; display: flex; flex-direction: column; gap: clamp(8px,1.4vw,16px); }
  .route-spine { position: absolute; left: clamp(28px,3.4vw,40px); top: 16px; bottom: 16px; width: 1px;
    background: linear-gradient(var(--line), var(--accent) 30%, var(--accent) 70%, var(--line));
    transform: scaleY(0); transform-origin: top; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .route.in .route-spine { transform: scaleY(1); }
  .route-stop { display: grid; grid-template-columns: clamp(56px,6.8vw,80px) clamp(54px,6vw,68px) 1fr auto;
    align-items: center; gap: clamp(12px,2vw,22px); padding: clamp(8px,1.2vw,12px) 0; background: none; border: none;
    text-align: left; color: var(--ink); cursor: pointer; opacity: 0; transform: translateX(-14px);
    transition: opacity .6s ease, transform .6s cubic-bezier(.2,.7,.2,1); transition-delay: calc(var(--i) * .1s + .25s); }
  .route.in .route-stop { opacity: 1; transform: none; }
  .route-node { justify-self: center; width: 13px; height: 13px; border-radius: 50%; background: var(--paper);
    border: 1.5px solid var(--accent); position: relative; z-index: 1; transition: background .3s, box-shadow .3s; }
  .route-stop:hover .route-node { background: var(--accent); box-shadow: 0 0 0 6px var(--chip); }
  .route-thumb { width: clamp(54px,6vw,68px); height: clamp(54px,6vw,68px); border-radius: 14px; overflow: hidden; }
  .route-city { display: block; font-size: clamp(20px,2.4vw,30px); font-weight: 600; letter-spacing: -.01em; }
  .route-days { display: block; font-size: clamp(12px,1.2vw,14px); color: var(--ink-soft); margin-top: 3px; }
  .route-go { color: var(--accent); opacity: .4; transition: opacity .3s, transform .3s; }
  .route-stop:hover .route-go { opacity: 1; transform: translateX(5px); }

  /* travelers */
  .party-head { margin-bottom: clamp(24px,4vw,40px); }
  .party-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: clamp(16px,2vw,26px); }
  .trav { display: flex; flex-direction: column; gap: 14px; opacity: 0; transform: translateY(20px);
    transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1); transition-delay: calc(var(--i) * .09s + .2s); }
  .party.in .trav { opacity: 1; transform: none; }
  .trav-photo { width: 100%; aspect-ratio: 1 / 1; border-radius: 18px; overflow: hidden;
    box-shadow: 0 16px 38px -22px rgba(0,0,0,.6); }
  .trav-name { font-size: clamp(18px,1.9vw,22px); font-weight: 600; letter-spacing: -.01em; }
  .trav-role { display: block; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; font-weight: 600;
    color: var(--accent); margin-top: 5px; }
  .lookbook[data-lang="th"] .trav-role { letter-spacing: normal; text-transform: none; font-size: 13px; }
  .trav-meta { display: flex; flex-direction: column; gap: 7px; margin-top: 12px; }
  .trav-meta-row { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-soft); }
  .trav-meta-row svg { color: var(--accent-2); flex: none; }

  /* begin */
  .ov-begin-wrap { max-width: 1100px; margin: 0 auto; padding: clamp(30px,5vw,56px) clamp(22px,4vw,56px) clamp(60px,9vw,110px);
    border-top: 1px solid var(--line); width: 100%; }
  .ov-begin { display: inline-flex; align-items: center; gap: 16px; background: none; border: none; color: var(--ink);
    font-size: 14px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; padding: 6px 0; position: relative; }
  .lookbook[data-lang="th"] .ov-begin { letter-spacing: normal; text-transform: none; font-size: 16px; }
  .ov-begin::after { content: ""; position: absolute; left: 0; bottom: 0; height: 1px; width: calc(100% - 62px);
    background: var(--accent); transition: width .4s ease; }
  /* continent/island sub-line (country context under the big island title) */
  .ov-country-sub { font-size: clamp(14px,1.5vw,19px); font-weight: 600; color: var(--accent);
    margin-top: 12px; letter-spacing: .01em; animation: rise 1.1s .36s ease both; }

  /* overview essentials — exchange rate + Visit Japan Web */
  .ov-ess { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%,260px),1fr)); gap: clamp(10px,1.4vw,14px);
    margin-top: clamp(22px,3vw,32px); max-width: 620px; animation: rise 1.1s .5s ease both; }
  .ov-ess-card { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px;
    padding: 15px 17px; border: 1px solid var(--line); border-radius: 16px; background: var(--paper-2);
    text-decoration: none; color: var(--ink); transition: border-color .3s, background .3s, transform .3s; }
  .ov-ess-card:hover { border-color: var(--accent); background: var(--chip); transform: translateY(-1px); }
  .ov-ess-ic { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 13px;
    border: 1px solid var(--line); color: var(--accent); flex: none; }
  .ov-ess-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .ov-ess-label { font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--ink-soft); }
  .lookbook[data-lang="th"] .ov-ess-label { letter-spacing: normal; text-transform: none; font-size: 12px; }
  .ov-ess-rate { font-family: var(--serif); font-size: clamp(20px,2.2vw,26px); font-weight: 600; letter-spacing: -.01em;
    color: var(--ink); font-variant-numeric: tabular-nums; line-height: 1.05; }
  .ov-ess-eq { color: var(--ink-soft); font-weight: 400; }
  .ov-ess-note, .ov-ess-desc { font-size: 12px; color: var(--ink-soft); }
  .ov-ess-desc { font-size: 13px; line-height: 1.35; margin-top: 2px; text-wrap: pretty; }
  .ov-ess-vjw .ov-ess-label { font-family: var(--serif); font-size: clamp(16px,1.8vw,19px); font-weight: 600;
    letter-spacing: -.01em; text-transform: none; color: var(--ink); }
  .lookbook[data-lang="th"] .ov-ess-vjw .ov-ess-label { font-size: clamp(16px,1.8vw,19px); }
  .ov-ess-go { color: var(--accent); opacity: .4; transition: opacity .3s, transform .3s; flex: none; }
  .ov-ess-card:hover .ov-ess-go { opacity: 1; transform: translate(2px,-2px); }
  /* exchange rate is reference-only — no link affordance */
  .ov-ess-fx { grid-template-columns: auto 1fr; cursor: default; }
  .ov-ess-fx:hover { border-color: var(--line); background: var(--paper-2); transform: none; }

  /* begin — floating action, always tappable on the Overview */
  .ov-stage { padding-bottom: clamp(96px, 12vw, 132px); }
  .ov-begin-float { position: fixed; left: 50%; bottom: clamp(20px, 3.5vh, 36px); transform: translateX(-50%);
    z-index: 40; display: inline-flex; align-items: center; gap: 14px; padding: 13px 16px 13px 26px;
    background: var(--ink); color: var(--paper); border: none; border-radius: 100px;
    font-size: 14px; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; white-space: nowrap;
    box-shadow: 0 12px 40px -10px rgba(0,0,0,.6), 0 0 0 1px color-mix(in srgb, var(--ink) 20%, transparent);
    cursor: pointer; animation: floatIn 1s .8s cubic-bezier(.2,.8,.2,1) both;
    transition: transform .3s ease, box-shadow .3s ease, gap .3s ease; }
  .ov-begin-float:hover { transform: translateX(-50%) translateY(-3px); gap: 18px;
    box-shadow: 0 18px 50px -10px rgba(0,0,0,.7), 0 0 0 1px color-mix(in srgb, var(--ink) 30%, transparent); }
  .lookbook[data-lang="th"] .ov-begin-float { letter-spacing: normal; text-transform: none; font-size: 16px; }
  .ov-begin-float-i { display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 18%, transparent); color: var(--paper); }
  @keyframes floatIn { from { opacity: 0; transform: translateX(-50%) translateY(24px); } to { opacity: 1; transform: translateX(-50%); } }

  /* WWN wordmark */
  .chrome-home .wwn, .wordmark { display: inline-flex; align-items: baseline; gap: 8px; }
  .chrome-home .wwn b, .wordmark b { font-weight: 800; letter-spacing: .06em; color: var(--accent); }
  .chrome-home .wwn { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; }

  /* traveler contact links */
  .trav-link { text-decoration: none; transition: color .25s; }
  a.trav-link:hover { color: var(--accent); }
  .trav-link .mono, .trav-meta-row.mono { font-variant-numeric: tabular-nums; }

  /* ── EMERGENCY ── */
  .ov-kicker-alert { color: var(--accent-2); }
  .ov-kicker-alert::before { background: var(--accent-2); }
  .emg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: clamp(8px,1.2vw,12px); }
  .emg { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px;
    padding: 14px 16px; border: 1px solid var(--line); border-radius: 14px; background: none; text-decoration: none;
    color: var(--ink); opacity: 0; transform: translateY(16px);
    transition: border-color .3s, background .3s, transform .6s ease, opacity .6s ease; transition-delay: calc(var(--i) * .06s + .15s); }
  .party.in .emg { opacity: 1; transform: none; }
  .emg:hover { border-color: var(--accent); background: var(--chip); }
  .emg-ic { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid var(--line); color: var(--accent); flex: none; }
  .emg-urgent .emg-ic { background: var(--accent); border-color: var(--accent); color: var(--paper); }
  .emg-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .emg-label { font-size: 12px; color: var(--ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .emg-value { font-size: 16px; font-weight: 600; color: var(--ink); letter-spacing: .02em; }
  .emg-urgent .emg-value { font-size: 20px; color: var(--accent); }
  .emg-go { color: var(--accent); opacity: .4; transition: opacity .3s, transform .3s; flex: none; }
  .emg:hover .emg-go { opacity: 1; transform: translateX(3px); }

  /* ── BUDGET ── */
  .bud-list { display: flex; flex-direction: column; }
  .bud-row { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(80px, 1.4fr) auto; align-items: center;
    gap: clamp(14px,2vw,28px); padding: 15px 0; border-top: 1px solid var(--line-soft);
    opacity: 0; transform: translateX(-12px); transition: opacity .6s ease, transform .6s cubic-bezier(.2,.7,.2,1);
    transition-delay: calc(var(--i) * .07s + .15s); }
  .party.in .bud-row { opacity: 1; transform: none; }
  .bud-label { font-size: clamp(14px,1.4vw,16px); font-weight: 500; }
  .bud-bar { height: 5px; border-radius: 100px; background: var(--line-soft); overflow: hidden; }
  .bud-fill { display: block; height: 100%; width: calc(var(--p) * 100%); border-radius: 100px;
    background: linear-gradient(90deg, var(--accent-2), var(--accent)); transform-origin: left; transform: scaleX(0);
    transition: transform 1s cubic-bezier(.2,.7,.2,1); transition-delay: calc(var(--i) * .07s + .3s); }
  .party.in .bud-fill { transform: scaleX(1); }
  .bud-amt { font-size: clamp(15px,1.5vw,18px); font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
  .bud-total { display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
    margin-top: 8px; padding-top: 20px; border-top: 1.5px solid var(--accent); }
  .bud-total-k { font-size: clamp(13px,1.3vw,15px); letter-spacing: .12em; text-transform: uppercase; font-weight: 600; color: var(--ink-soft); }
  .lookbook[data-lang="th"] .bud-total-k { letter-spacing: normal; text-transform: none; font-size: 15px; }
  .bud-total-v { font-size: clamp(28px,3.6vw,44px); font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; letter-spacing: -.01em; }
  .bud-note { font-size: 12.5px; color: var(--ink-soft); margin-top: 14px; opacity: .8; }

  /* ── CREDIT ── */
  .ov-credit { max-width: 1100px; margin: 0 auto; width: 100%; padding: clamp(20px,3vw,30px) clamp(22px,4vw,56px) clamp(40px,6vw,64px);
    display: flex; align-items: center; gap: 16px; }
  .ov-credit-rule { flex: 1; height: 1px; background: var(--line); }
  .ov-credit-text { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; font-weight: 600; color: var(--ink-soft); }
  .lookbook[data-lang="th"] .ov-credit-text { letter-spacing: .04em; text-transform: none; font-size: 13px; }

  .view-itinerary { height: 100%; display: flex; flex-direction: column; animation: coverIn .7s ease both; }
  .stage-credit { margin-top: 30px; text-align: center; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; font-weight: 600; color: var(--ink-soft); opacity: .65; }
  .lookbook[data-lang="th"] .stage-credit { letter-spacing: .04em; text-transform: none; font-size: 12.5px; }

  /* chrome shell — two rows: a bar (logo · date · clock/lang) + a scrollable day rail */
  .chrome { flex: none; border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(16px) saturate(140%); position: sticky; top: 0; z-index: 20;
    transition: background-color .9s ease; }
  .chrome-stack { display: flex; flex-direction: column; }
  .chrome-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 0 clamp(16px, 3vw, 40px); height: 58px; }
  .chrome-min { display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 0 clamp(16px, 3vw, 40px); height: 60px; }
  .chrome-home { display: inline-flex; align-items: center; gap: 9px; background: none; border: none;
    font-size: 14px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--ink); flex: none; }
  .chrome-home svg { color: var(--accent); }
  .chrome-bar-r { display: inline-flex; align-items: center; gap: 14px; flex: none; }

  /* active day + date in the header */
  .chrome-now { display: inline-flex; align-items: center; gap: 12px; min-width: 0; overflow: hidden; }
  .chrome-now-day { font-weight: 600; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); flex: none; }
  .chrome-now-sep { width: 1px; height: 14px; background: var(--line); flex: none; }
  .chrome-now-date { font-size: 13px; font-weight: 500; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* live clock */
  .clock-chrome { display: inline-flex; align-items: center; gap: 7px; padding: 5px 11px; border-radius: 100px;
    border: 1px solid var(--line); color: var(--ink-soft); }
  .clock-chrome .clock-ic { display: inline-flex; color: var(--accent); }
  .clock-zone { font-size: 10px; letter-spacing: .14em; font-weight: 600; }
  .clock-time { font-size: 12.5px; letter-spacing: .02em; color: var(--ink); font-variant-numeric: tabular-nums; }

  /* scrollable day rail */
  .chrome-days { display: flex; align-items: stretch; gap: clamp(4px, 0.8vw, 12px); height: 64px;
    padding: 0 clamp(12px, 3vw, 36px); overflow-x: auto; overflow-y: hidden; scrollbar-width: none;
    border-top: 1px solid var(--line-soft); scroll-snap-type: x proximity; }
  .chrome-days::-webkit-scrollbar { display: none; }
  .chrome-day { position: relative; display: inline-flex; align-items: center; gap: 10px; background: none;
    border: none; padding: 0 clamp(8px,1vw,14px); color: var(--ink-soft); transition: color .3s; flex: none;
    scroll-snap-align: center; }
  .chrome-day::after { content: ""; position: absolute; left: 10px; right: 10px; bottom: 0; height: 2px;
    background: var(--accent); transform: scaleX(0); transform-origin: center; transition: transform .35s cubic-bezier(.3,.7,.3,1); }
  .chrome-day:hover { color: var(--ink); }
  .chrome-day.active { color: var(--ink); }
  .chrome-day.active::after { transform: scaleX(1); }
  .chrome-day-num { font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: -.01em;
    color: var(--accent); opacity: .5; transition: opacity .3s; }
  .chrome-day:hover .chrome-day-num, .chrome-day.active .chrome-day-num { opacity: 1; }
  .chrome-day-info { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
  .chrome-day-name { font-size: 12px; font-weight: 600; letter-spacing: .01em; white-space: nowrap; }
  .chrome-day-date { font-size: 10.5px; font-weight: 500; color: var(--ink-soft); white-space: nowrap; }

  .stage { flex: 1; overflow-y: auto; scroll-behavior: smooth; }
  .stage-inner { max-width: 1180px; margin: 0 auto; padding: clamp(40px,6vw,90px) clamp(20px,4vw,56px) 40px;
    animation: fadeUp .7s ease both; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

  /* ───────────────────────── DAY HEADER ───────────────────────── */
  .day-head { margin-bottom: clamp(28px,5vw,64px); }
  .day-head-row { display: flex; align-items: center; gap: 18px; margin-bottom: 18px; }
  .day-label { font-size: 12px; letter-spacing: .28em; text-transform: uppercase; font-weight: 600; color: var(--accent); }
  .day-rule { flex: none; width: 56px; height: 1px; background: var(--line); }
  .day-sub { font-family: var(--serif); font-style: italic; font-size: 17px; color: var(--ink-soft); }
  .day-title { font-family: var(--serif); font-weight: 500; letter-spacing: -.02em; line-height: .94;
    font-size: calc(clamp(48px, 8vw, 104px) * var(--scale)); }
  .day-note { font-family: var(--serif); font-size: clamp(17px,1.5vw,21px); line-height: 1.5; color: var(--ink-soft);
    max-width: 38ch; margin-top: clamp(14px,2vw,22px); text-wrap: pretty; }

  /* ───────────────────────── TIMELINE (editorial left-spine) ───────────────────────── */
  .timeline { position: relative; --spine-w: clamp(30px, 4vw, 56px); }
  .tl-row { position: relative; display: grid;
    grid-template-columns: var(--spine-w) minmax(0, 1fr);
    padding-bottom: clamp(48px, 7vh, 104px);
    opacity: 0; transform: translateY(30px);
    transition: opacity .8s ease, transform .8s cubic-bezier(.2,.7,.2,1);
    transition-delay: calc(var(--i) * .06s); }
  .tl-row.in { opacity: 1; transform: none; }

  /* the spine + node */
  .tl-mid { position: relative; }
  .tl-mid::before { content: ""; position: absolute; left: 6px; top: 6px; bottom: -1px; width: 1px;
    background: linear-gradient(var(--line) 0%, var(--line) 88%, transparent 100%); }
  .tl-row:last-of-type .tl-mid::before { bottom: 40%; }
  .tl-dot { position: absolute; left: 6px; top: 6px; width: 13px; height: 13px; border-radius: 50%;
    transform: translate(-50%, 0); background: var(--paper); border: 1.5px solid var(--accent);
    transition: background .35s, transform .35s, box-shadow .35s; z-index: 2; }
  .tl-dot::after { content: ""; position: absolute; inset: 3px; border-radius: 50%; background: var(--accent);
    opacity: 0; transform: scale(.4); transition: opacity .35s, transform .35s; }
  .tl-row:hover .tl-dot { box-shadow: 0 0 0 5px var(--chip); }
  .tl-row:hover .tl-dot::after { opacity: 1; transform: none; }

  /* content column */
  .tl-content { min-width: 0; }
  .tl-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: clamp(16px,2vw,24px);
    cursor: pointer; }
  .tl-time { font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1;
    font-size: calc(clamp(26px, 3vw, 40px) * var(--scale)); letter-spacing: -.02em; color: var(--ink); }
  .tl-meridiem { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; font-weight: 600;
    color: var(--accent-2); }
  .tl-headrule { flex: 1; height: 1px; min-width: 24px; background: var(--line);
    transform-origin: left; transform: scaleX(.5); transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .tl-row.in .tl-headrule { transform: scaleX(1); }

  /* activity — hero image over a two-column caption */
  .activity { display: block; cursor: pointer; }
  .activity-media { position: relative; }
  .activity-media .img-frame { border-radius: 18px; }
  .activity:hover .img-frame image-slot { transform: scale(1.05); }

  .activity-caption { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 56px); align-items: start; margin-top: clamp(18px, 2vw, 26px); }
  .activity-text { min-width: 0; display: flex; flex-direction: column; }
  .activity-title { font-weight: 600; line-height: 1.06; letter-spacing: -.02em;
    font-size: calc(clamp(24px, 2.6vw, 36px) * var(--scale)); align-self: flex-start;
    background-image: linear-gradient(var(--accent), var(--accent)); background-size: 0% 1px;
    background-repeat: no-repeat; background-position: 0 100%;
    transition: background-size .5s cubic-bezier(.2,.7,.2,1); padding-bottom: 3px; }
  .activity:hover .activity-title { background-size: 100% 1px; }
  .activity-place { font-size: clamp(14px,1.3vw,16.5px); font-weight: 500;
    color: var(--ink-soft); margin-top: 10px; }
  .activity-blurb { font-size: clamp(15px,1.4vw,17px); line-height: 1.6; font-weight: 400;
    color: var(--ink-soft); max-width: 48ch; text-wrap: pretty; margin-top: 14px; }

  .activity-open { display: inline-flex; align-items: center; gap: 10px; align-self: flex-start;
    background: none; border: none; font-size: 11px; letter-spacing: .16em; text-transform: uppercase;
    font-weight: 600; color: var(--ink); margin-top: 22px; opacity: .55; transition: opacity .3s; }
  .activity:hover .activity-open { opacity: 1; }
  .activity-open svg { transition: transform .3s; }
  .activity-open:hover svg { transform: translateX(4px); }
  .activity-foot { padding-top: 4px; }

  /* ───────────────────────── REFERENCE DOCK ───────────────────────── */
  .dock { margin-top: auto; }
  .dock-rail { display: flex; flex-wrap: wrap; gap: 7px; }
  .dock-chip { display: inline-flex; align-items: center; gap: 7px; padding: 7px 12px;
    border: 1px solid var(--line); border-radius: 100px; background: transparent; color: var(--ink-soft);
    font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; font-weight: 500;
    transition: background .25s, color .25s, border-color .25s, transform .25s; }
  .dock-chip:hover { background: var(--chip); color: var(--ink); transform: translateY(-1px); }
  .dock-chip.active { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .dock-chip svg { transition: transform .25s; }
  .dock-chip.active svg { transform: rotate(0); }

  .dock-drawer { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .45s cubic-bezier(.3,.7,.2,1); }
  .dock-drawer-inner { min-height: 0; overflow: hidden; }
  .dock-detail { padding-top: 14px; animation: fadeIn .4s ease both; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .dock-link { display: inline-flex; align-items: center; gap: 9px; color: var(--accent);
    font-size: 14px; letter-spacing: .01em; text-decoration: none; padding-bottom: 2px;
    border-bottom: 1px solid transparent; transition: border-color .3s; }
  .dock-link:hover { border-color: var(--accent); }
  .dock-link-url { font-family: var(--sans); }
  .dock-text { font-family: var(--sans); font-size: 14px; color: var(--ink); letter-spacing: .01em; }
  .dock-notes { font-family: var(--serif); font-style: italic; font-size: 16px; line-height: 1.5;
    color: var(--ink-soft); max-width: 48ch; text-wrap: pretty; }
  .dock-res { display: flex; flex-direction: column; gap: 7px; max-width: 320px; }
  .dock-res-row { display: flex; justify-content: space-between; gap: 18px; align-items: baseline;
    border-bottom: 1px dotted var(--line); padding-bottom: 6px; }
  .dock-res-k { font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-soft); }
  .dock-res-v { font-family: var(--serif); font-size: 15px; }
  .mono { font-family: ui-monospace, "SFMono-Regular", Menlo, monospace; font-size: 13px; letter-spacing: .04em; }

  /* dock expanded (detail overlay) */
  .dock-expanded { display: flex; flex-direction: column; }
  .dock-card { display: grid; grid-template-columns: 150px minmax(0,1fr); gap: 20px; align-items: start;
    padding: 18px 0; border-top: 1px solid var(--line-soft); }
  .dock-card:last-child { border-bottom: 1px solid var(--line-soft); }
  .dock-card-hd { display: inline-flex; align-items: center; gap: 10px; color: var(--ink-soft); padding-top: 1px; }
  .dock-card-label { font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; font-weight: 500; }
  .dock-card-body { min-width: 0; }

  /* ───────────────────────── TIMELINE END / FOOTER ───────────────────────── */
  .tl-end { grid-column: 1 / -1; display: none; }
  .stage-foot { margin-top: clamp(30px,5vw,60px); }
  .stage-foot-line { height: 1px; background: var(--line); margin-bottom: 28px; }
  .stage-next { display: flex; align-items: center; gap: 16px; width: 100%; background: none; border: none;
    padding: 18px 0; text-align: left; }
  .stage-next-k { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-soft); }
  .stage-next-t { font-family: var(--serif); font-size: clamp(22px,2.4vw,30px); font-weight: 500; flex: 1; }
  .stage-next svg { color: var(--accent); transition: transform .35s; }
  .stage-next:hover svg { transform: translateX(8px); }
  .stage-foot-end { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px;
    padding: 24px 0 8px; color: var(--ink-soft); }
  .stage-foot-end svg { color: var(--accent); }
  .stage-foot-end p { font-family: var(--serif); font-style: italic; font-size: clamp(18px,2vw,24px); }

  /* ───────────────────────── DETAIL OVERLAY ───────────────────────── */
  .detail-scrim { position: fixed; inset: 0; z-index: 60; display: flex; justify-content: flex-end;
    background: rgba(14,12,9,.42); backdrop-filter: blur(7px); animation: fadeIn .35s ease both; }
  .detail { width: min(560px, 100%); height: 100%; background: var(--paper); overflow-y: auto; position: relative;
    box-shadow: -30px 0 80px rgba(0,0,0,.28); animation: slideIn .5s cubic-bezier(.2,.8,.2,1) both; }
  @keyframes slideIn { from { transform: translateX(100%); } to { transform: none; } }
  .detail-close { position: absolute; top: 18px; right: 18px; z-index: 5; display: grid; place-items: center;
    width: 42px; height: 42px; border-radius: 50%; background: rgba(20,18,15,.4); backdrop-filter: blur(8px);
    border: .5px solid rgba(255,255,255,.2); color: #f6f2ea; transition: background .3s; }
  .detail-close:hover { background: rgba(20,18,15,.62); }
  .detail-media { position: relative; height: 44vh; min-height: 280px; }
  .detail-img.img-frame { position: absolute; inset: 0; height: 100%; width: 100%; }
  .detail-body { padding: clamp(26px,4vw,44px); }
  .detail-time { display: inline-flex; align-items: center; gap: 8px; font-size: 11px; letter-spacing: .18em;
    text-transform: uppercase; color: var(--accent); font-weight: 600; }
  .detail-title { font-family: var(--serif); font-weight: 500; line-height: 1.02; letter-spacing: -.02em;
    font-size: clamp(34px,5vw,52px); margin-top: 14px; }
  .detail-place { font-family: var(--serif); font-style: italic; font-size: 18px; color: var(--ink-soft); margin-top: 10px; }
  .detail-blurb { font-family: var(--serif); font-size: 18px; line-height: 1.6; color: var(--ink-soft);
    margin-top: 18px; text-wrap: pretty; }
  .detail-dock-head { display: flex; align-items: center; gap: 14px; margin-top: 34px; margin-bottom: 6px; }
  .detail-dock-line { flex: none; width: 30px; height: 1px; background: var(--accent); }
  .detail-dock-label { font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; font-weight: 600; color: var(--ink-soft); }

  /* ───────────────────────── CHROME NAV BUTTON ───────────────────────── */
  .chrome-nav { display: inline-flex; align-items: center; gap: 8px; padding: 6px 13px; border-radius: 100px;
    border: 1px solid var(--line); background: none; color: var(--ink-soft);
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600;
    transition: border-color .25s, color .25s, background .25s; flex: none; }
  .chrome-nav svg { color: var(--accent); }
  .chrome-nav:hover { border-color: var(--accent); color: var(--ink); background: var(--chip); }
  .lookbook[data-lang="th"] .chrome-nav { letter-spacing: normal; text-transform: none; font-size: 13px; }

  /* SOS / emergency shortcut */
  .chrome-sos { display: inline-flex; align-items: center; gap: 8px; padding: 6px 13px; border-radius: 100px;
    border: 1px solid color-mix(in srgb, var(--accent-2) 55%, var(--line)); background: none; color: var(--accent-2);
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700;
    transition: background .25s, color .25s, border-color .25s; flex: none; }
  .chrome-sos svg { color: var(--accent-2); transition: color .25s; }
  .chrome-sos:hover { background: var(--accent-2); color: var(--paper); border-color: var(--accent-2); }
  .chrome-sos:hover svg { color: var(--paper); }
  .lookbook[data-lang="th"] .chrome-sos { letter-spacing: normal; text-transform: none; font-size: 13px; }

  /* emergency quick sheet */
  .emg-scrim { position: fixed; inset: 0; z-index: 80; display: flex; align-items: flex-start; justify-content: center;
    padding: clamp(64px,12vh,130px) 16px 24px; background: rgba(8,6,4,.5); backdrop-filter: blur(8px);
    animation: fadeIn .3s ease both; }
  .emg-sheet { width: min(470px, 100%); max-height: 78vh; overflow-y: auto; background: var(--paper);
    border: 1px solid var(--line); border-radius: 20px; padding: clamp(20px,3vw,28px);
    box-shadow: 0 40px 90px -24px rgba(0,0,0,.7); animation: sheetIn .42s cubic-bezier(.2,.8,.2,1) both; }
  @keyframes sheetIn { from { opacity: 0; transform: translateY(-18px) scale(.98); } to { opacity: 1; transform: none; } }
  .emg-sheet-hd { display: flex; align-items: flex-start; gap: 13px; margin-bottom: 20px; }
  .emg-sheet-ic { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    background: var(--accent-2); color: var(--paper); flex: none; }
  .emg-sheet-titles { flex: 1; min-width: 0; }
  .emg-sheet-kicker { display: block; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; font-weight: 600; color: var(--accent-2); }
  .lookbook[data-lang="th"] .emg-sheet-kicker { letter-spacing: normal; text-transform: none; font-size: 12.5px; }
  .emg-sheet-title { font-family: var(--serif); font-size: clamp(22px,3vw,28px); font-weight: 600; letter-spacing: -.01em; margin-top: 4px; }
  .emg-sheet-close { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
    border: 1px solid var(--line); background: none; color: var(--ink-soft); flex: none; transition: background .25s, color .25s; }
  .emg-sheet-close:hover { background: var(--chip); color: var(--ink); }
  .emg-sheet-grid { display: flex; flex-direction: column; gap: 9px; }
  .emg-sheet-grid .emg { opacity: 1; transform: none; transition: border-color .25s, background .25s; }

  /* konbini — convenience stores near each stay */
  .kon-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%,300px),1fr)); gap: clamp(8px,1.2vw,12px); }
  .kon { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; padding: 14px 16px;
    border: 1px solid var(--line); border-radius: 14px; text-decoration: none; color: var(--ink);
    opacity: 0; transform: translateY(16px); transition: border-color .3s, background .3s, transform .6s ease, opacity .6s ease;
    transition-delay: calc(var(--i) * .06s + .15s); }
  .party.in .kon { opacity: 1; transform: none; }
  .kon:hover { border-color: var(--accent); background: var(--chip); }
  .kon-ic { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px;
    border: 1px solid var(--line); color: var(--accent); flex: none; }
  .kon-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .kon-top { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .kon-brand { font-size: 15px; font-weight: 700; letter-spacing: .01em; }
  .kon-day { font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; color: var(--accent); }
  .lookbook[data-lang="th"] .kon-day { letter-spacing: normal; text-transform: none; font-size: 12px; }
  .kon-stay { font-size: 13px; color: var(--ink); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .kon-detail { font-size: 12px; color: var(--ink-soft); }
  .kon-go { color: var(--accent); opacity: .4; transition: opacity .3s, transform .3s; flex: none; }
  .kon:hover .kon-go { opacity: 1; transform: translate(2px,-2px); }
  .kon-note { font-size: 12.5px; color: var(--ink-soft); margin-top: 14px; opacity: .8; max-width: 64ch; text-wrap: pretty; }

  /* per-day konbini — top of each day, multiple stores */
  .dkon { margin: 2px 0 clamp(26px,4vw,44px); padding: clamp(14px,2vw,18px); border: 1px solid var(--line);
    border-radius: 16px; background: var(--paper-2); }
  .dkon-head { display: flex; align-items: center; gap: 12px; margin-bottom: 13px; }
  .dkon-ic { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px;
    border: 1px solid var(--line); color: var(--accent); flex: none; }
  .dkon-head-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .dkon-kicker { font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--ink-soft); }
  .lookbook[data-lang="th"] .dkon-kicker { letter-spacing: normal; text-transform: none; font-size: 12px; }
  .dkon-area { font-size: 14px; font-weight: 600; color: var(--ink); }
  .dkon-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%,200px),1fr)); gap: 8px; }
  .dkon-store { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 4px 10px;
    padding: 11px 13px; border: 1px solid var(--line); border-radius: 11px; text-decoration: none; color: var(--ink);
    transition: border-color .25s, background .25s; }
  .dkon-store:hover { border-color: var(--accent); background: var(--chip); }
  .dkon-brand { font-size: 14px; font-weight: 700; letter-spacing: .01em; }
  .dkon-detail { grid-column: 1 / -1; font-size: 12px; color: var(--ink-soft); }
  .dkon-go { color: var(--accent); opacity: .5; flex: none; transition: opacity .25s, transform .25s; }
  .dkon-store:hover .dkon-go { opacity: 1; transform: translate(2px,-2px); }

  /* ───────────────────────── FOOTER NAV (prev / next) ───────────────────────── */
  .stage-foot-nav { display: flex; align-items: center; justify-content: space-between; gap: clamp(16px,3vw,40px); }
  .stage-foot-spacer { flex: none; }
  .stage-prev { display: inline-flex; align-items: center; gap: 14px; background: none; border: none;
    padding: 14px 0; text-align: left; color: var(--ink-soft); transition: color .3s; }
  .stage-prev:hover { color: var(--ink); }
  .stage-prev-i { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid var(--line); color: var(--accent); flex: none; transition: transform .35s, border-color .3s; }
  .stage-prev:hover .stage-prev-i { transform: translateX(-5px); border-color: var(--accent); }
  .stage-prev-txt { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .stage-prev-k { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-soft); }
  .stage-prev-t { font-family: var(--serif); font-size: clamp(16px,1.7vw,20px); font-weight: 500; color: var(--ink);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .stage-foot-nav .stage-next { width: auto; padding: 14px 0; gap: 14px; justify-content: flex-end; }
  .stage-next-txt { display: flex; flex-direction: column; gap: 3px; align-items: flex-end; text-align: right; min-width: 0; }
  .stage-next-txt .stage-next-t { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .stage-foot-nav .stage-foot-end { padding: 0; align-items: flex-end; text-align: right; }
  .lookbook[data-lang="th"] .stage-prev-k, .lookbook[data-lang="th"] .stage-next-k { letter-spacing: normal; text-transform: none; }

  /* ───────────────────────── BOOKINGS ───────────────────────── */
  .bookings { height: 100%; display: flex; flex-direction: column; animation: coverIn .7s ease both; }
  .bk-stage { flex: 1; overflow-y: auto; scroll-behavior: smooth; }
  .bk-hero, .bk-sec { max-width: 1100px; margin: 0 auto; width: 100%; }
  .bk-hero { padding: clamp(40px,7vh,84px) clamp(22px,4vw,56px) clamp(28px,4vw,40px); }
  .bk-h1 { font-family: var(--serif); font-weight: 700; letter-spacing: -.02em; line-height: 1; margin-top: 14px;
    font-size: calc(clamp(40px,6.5vw,84px) * var(--scale)); animation: rise 1s .1s ease both; }
  .bk-lede { font-size: clamp(16px,1.7vw,21px); line-height: 1.5; color: var(--ink-soft); max-width: 50ch;
    margin-top: 16px; text-wrap: pretty; }

  .bk-progress { margin-top: clamp(26px,4vw,40px); max-width: 540px; }
  .bk-progress-top { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
  .bk-progress-k { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--ink-soft); }
  .lookbook[data-lang="th"] .bk-progress-k { letter-spacing: normal; text-transform: none; font-size: 13.5px; }
  .bk-progress-v { font-variant-numeric: tabular-nums; font-size: 14px; font-weight: 500; color: var(--ink-soft); }
  .bk-progress-v b { color: var(--accent); font-size: 22px; font-weight: 700; }
  .bk-progress-bar { display: block; height: 6px; border-radius: 100px; background: var(--line-soft); overflow: hidden; }
  .bk-progress-fill { display: block; height: 100%; border-radius: 100px;
    background: linear-gradient(90deg, var(--accent-2), var(--accent)); width: calc(var(--p) * 100%);
    transition: width .8s cubic-bezier(.2,.7,.2,1); }

  .bk-sec { padding: clamp(14px,2.5vw,26px) clamp(22px,4vw,56px); }
  .bk-sec-head { display: flex; align-items: center; gap: 14px; margin-bottom: clamp(18px,2.5vw,24px);
    padding-top: clamp(16px,2.5vw,28px); border-top: 1px solid var(--line); }
  .bk-sec-ic { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid var(--line); color: var(--accent); flex: none; }
  .bk-sec-title { font-family: var(--serif); font-size: clamp(22px,2.6vw,32px); font-weight: 600; letter-spacing: -.01em; }
  .bk-sec-count { margin-left: auto; font-size: 13px; font-weight: 700; color: var(--ink-soft);
    font-variant-numeric: tabular-nums; padding: 3px 11px; border: 1px solid var(--line); border-radius: 100px; }

  .bk-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); gap: clamp(12px,1.6vw,18px); }
  .bk-card { border: 1px solid var(--line); border-radius: 16px; padding: clamp(16px,2vw,22px); background: var(--paper-2);
    display: flex; flex-direction: column; gap: 13px; transition: border-color .3s, background .3s; }
  .bk-card.is-booked { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); background: var(--chip); }
  .bk-card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .bk-badge { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; letter-spacing: .1em;
    text-transform: uppercase; font-weight: 600; color: var(--ink-soft); }
  .bk-badge b { color: var(--accent); font-weight: 700; }
  .lookbook[data-lang="th"] .bk-badge { letter-spacing: normal; text-transform: none; font-size: 12.5px; }
  .bk-status { display: inline-flex; align-items: center; gap: 8px; padding: 6px 13px 6px 8px; border-radius: 100px;
    border: 1px solid var(--line); background: none; color: var(--ink-soft); font-size: 10.5px; letter-spacing: .1em;
    text-transform: uppercase; font-weight: 700; transition: all .25s; flex: none; }
  .bk-tick { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%;
    border: 1.5px solid currentColor; transition: all .25s; }
  .bk-tick svg { opacity: 0; transform: scale(.4); transition: opacity .2s, transform .2s; }
  .bk-status:hover { color: var(--ink); border-color: var(--ink-soft); }
  .bk-card.is-booked .bk-status { background: var(--accent); border-color: var(--accent); color: var(--paper); }
  .bk-card.is-booked .bk-tick { border-color: var(--paper); background: var(--paper); color: var(--accent); }
  .bk-card.is-booked .bk-tick svg { opacity: 1; transform: none; }
  .lookbook[data-lang="th"] .bk-status { letter-spacing: normal; text-transform: none; font-size: 12.5px; }

  .bk-card-body { display: flex; flex-direction: column; gap: 5px; }
  .bk-card-time { display: inline-flex; align-items: center; gap: 6px; font-variant-numeric: tabular-nums;
    font-size: 12.5px; font-weight: 600; letter-spacing: .04em; color: var(--ink-soft); }
  .bk-card-time svg { color: var(--accent); }
  .bk-card-title { font-family: var(--serif); font-size: clamp(19px,1.9vw,23px); font-weight: 600; line-height: 1.18; letter-spacing: -.01em; }
  .bk-card-place { font-size: 13.5px; color: var(--ink-soft); }

  .bk-meta { display: flex; flex-direction: column; gap: 9px; padding-top: 13px; border-top: 1px dotted var(--line); }
  .bk-meta-row { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; }
  .bk-meta-k { font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--ink-soft); flex: none; }
  .lookbook[data-lang="th"] .bk-meta-k { letter-spacing: normal; text-transform: none; font-size: 12.5px; }
  .bk-meta-v { font-size: 14px; font-weight: 500; color: var(--ink); text-align: right; }
  .bk-code { font-variant-numeric: tabular-nums; letter-spacing: .06em; font-weight: 700; color: var(--accent); font-size: 16px; }
  .bk-price { font-variant-numeric: tabular-nums; }

  .bk-card-foot { margin-top: 1px; }
  .bk-maplink { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; letter-spacing: .04em;
    color: var(--ink-soft); text-decoration: none; transition: color .25s; }
  .bk-maplink:hover { color: var(--accent); }

  .bk-pass-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); gap: clamp(8px,1.2vw,12px); }
  .bk-pass { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px;
    padding: 13px 16px; border: 1px solid var(--line); border-radius: 13px; transition: border-color .25s; }
  .bk-pass:hover { border-color: var(--accent); }
  .bk-pass-ic { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9px;
    border: 1px solid var(--line); color: var(--accent); flex: none; }
  .bk-pass-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .bk-pass-title { font-size: 14.5px; font-weight: 600; line-height: 1.2; }
  .bk-pass-place { font-size: 12px; color: var(--ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bk-pass-price { font-size: 14px; font-weight: 600; color: var(--accent); font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* recommended dishes (dining detail) */
  .detail-menu { margin-top: clamp(22px,3vw,30px); }
  .menu-list { list-style: none; display: flex; flex-direction: column; margin-top: 6px; }
  .menu-list li { border-bottom: 1px dotted var(--line); }
  .menu-list li:last-child { border-bottom: none; }
  .menu-item { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center;
    width: 100%; padding: 13px 4px; background: none; border: none; text-align: left;
    border-radius: 10px; transition: background .22s; }
  .menu-item:hover { background: var(--chip); }
  .menu-item:last-child { border-bottom: none; }
  .menu-bullet { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px;
    border: 1px solid var(--line); color: var(--accent); flex: none; margin-top: 1px; transition: background .25s, color .25s; }
  .menu-item.is-sig .menu-bullet { background: var(--accent); border-color: var(--accent); color: var(--paper); }
  .menu-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .menu-name { font-family: var(--serif); font-size: clamp(16px,1.7vw,19px); font-weight: 600; letter-spacing: -.01em;
    line-height: 1.2; display: inline-flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .menu-tag { font-family: var(--sans); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase;
    font-weight: 700; color: var(--accent); border: 1px solid var(--accent); border-radius: 100px; padding: 2px 9px; }
  .lookbook[data-lang="th"] .menu-tag { letter-spacing: normal; text-transform: none; font-size: 11px; }
  .menu-note { font-size: 13px; color: var(--ink-soft); line-height: 1.45; text-wrap: pretty; }
  .menu-go { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9px;
    border: 1px solid var(--line); color: var(--accent); flex: none; opacity: .55; transition: opacity .22s, background .22s, border-color .22s; }
  .menu-item:hover .menu-go { opacity: 1; background: var(--paper); border-color: var(--accent); }

  /* dish photo lightbox */
  .dish-scrim { position: fixed; inset: 0; z-index: 70; display: flex; align-items: center; justify-content: center;
    padding: 24px; background: rgba(8,6,4,.62); backdrop-filter: blur(9px); -webkit-backdrop-filter: blur(9px);
    animation: fadeIn .28s ease both; }
  .dish-box { position: relative; width: min(440px, 100%); background: var(--paper); border: 1px solid var(--line);
    border-radius: 20px; overflow: hidden; box-shadow: 0 40px 90px -24px rgba(0,0,0,.7);
    animation: sheetIn .42s cubic-bezier(.2,.8,.2,1) both; }
  .dish-img.img-frame { width: 100%; border-radius: 0; }
  .dish-close { position: absolute; top: 14px; right: 14px; z-index: 3; display: grid; place-items: center;
    width: 40px; height: 40px; border-radius: 50%; background: rgba(20,18,15,.45); backdrop-filter: blur(8px);
    border: .5px solid rgba(255,255,255,.2); color: #f6f2ea; transition: background .25s; }
  .dish-close:hover { background: rgba(20,18,15,.7); }
  .dish-meta { padding: clamp(16px,2.5vw,22px); display: flex; flex-direction: column; gap: 7px; }
  .dish-name { font-family: var(--serif); font-size: clamp(20px,2.4vw,26px); font-weight: 600; letter-spacing: -.01em;
    line-height: 1.15; display: inline-flex; align-items: baseline; gap: 11px; flex-wrap: wrap; }
  .dish-note { font-size: 14px; color: var(--ink-soft); line-height: 1.5; text-wrap: pretty; }

  /* ───────────────────────── MOBILE TAB BAR ───────────────────────── */
  .mtab { display: none; }
  .mtab { grid-template-columns: repeat(2, 1fr); gap: 4px;
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 55;
    padding: 7px 10px calc(7px + env(safe-area-inset-bottom, 0px));
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    backdrop-filter: blur(18px) saturate(140%); -webkit-backdrop-filter: blur(18px) saturate(140%);
    border-top: 1px solid var(--line); }
  .mtab-item { display: flex; flex-direction: column; align-items: center; gap: 4px;
    padding: 5px 4px 3px; background: none; border: none; color: var(--ink-soft);
    transition: color .25s; }
  .mtab-ic { display: grid; place-items: center; width: 50px; height: 28px; border-radius: 100px;
    transition: background .25s, color .25s; }
  .mtab-lb { font-size: 11px; font-weight: 600; letter-spacing: .02em; }
  .mtab-item.active { color: var(--accent); }
  .mtab-item.active .mtab-ic { background: var(--chip); color: var(--accent); }

  /* ───────────────────────── RESPONSIVE ───────────────────────── */
  @media (max-width: 760px) {
    .timeline { --spine-w: 26px; }
    .activity-caption { grid-template-columns: 1fr; gap: 18px; }
    .activity-media .img-frame { aspect-ratio: 3 / 2; }
    .dock-card { grid-template-columns: 1fr; gap: 8px; }
    .tl-time { font-size: clamp(24px, 7vw, 32px); }
    .tl-head { gap: 11px; }
    .chrome-now { display: none; }
    .clock-panel { flex-wrap: wrap; gap: 16px 24px; }
    .route-stop { grid-template-columns: clamp(40px,9vw,56px) 52px 1fr auto; }
    .ov-native { opacity: .04; }
  }
  @media (max-width: 680px) {
    .chrome-bar-r { gap: 10px; }
    .chrome-nav span, .chrome-sos span { display: none; }
    .chrome-nav, .chrome-sos { padding: 7px 9px; }
    .clock-chrome .clock-zone { display: none; }
    /* primary view nav relocates to the bottom tab bar on mobile */
    .chrome-nav { display: none; }
    .mtab { display: grid; }
    .bk-stage, .stage { padding-bottom: 92px; }
  }
  @media (max-width: 520px) {
    .wwn-full { display: none; }
    .chrome-bar-r { gap: 8px; }
  }
  @media (max-width: 460px) {
    .cover-origin { display: none; }
  }
  @media (max-width: 420px) {
    .clock-chrome { display: none; }
  }

  /* ───────────────────────── EMBED / FLOW (template board frames) ───────────────────────── */
  .no-anim .view-cover, .no-anim .view-itinerary, .no-anim .stage-inner { animation: none !important; }
  .no-anim .tl-row { opacity: 1 !important; transform: none !important; }
  .no-anim .cover-img image-slot { animation: kenburns 22s ease-in-out infinite alternate; }
  .lookbook.flow { height: auto; }
  .flow .view-itinerary { height: auto; }
  .flow .stage { overflow: visible; height: auto; }
  .flow .chrome { position: static; }

  /* ───────────────────────── ENRICHMENT (premium accents) ───────────────────────── */
  /* warm gold rule leading the cover kicker */
  .cover-kicker { display: flex; align-items: center; gap: 13px; }
  .cover-kicker::before { content: ""; width: 30px; height: 1px; background: #d8b27a; flex: none; }
  /* coloured, confident day numbers in the chrome */
  .chrome-day-num { color: var(--accent); opacity: .55; transition: opacity .3s; }
  .chrome-day:hover .chrome-day-num, .chrome-day.active .chrome-day-num { opacity: 1; }
  /* day header label gets a small accent marker */
  .day-label { display: inline-flex; align-items: center; gap: 9px; }
  .day-label::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); flex: none; }
  /* active reference chip carries the accent colour, not flat ink */
  .dock-chip.active { background: var(--accent); border-color: var(--accent); color: var(--paper); }
  .dock-chip.active svg { color: var(--paper); }
  /* richer image framing — warm shadow + crisp hairline */
  .activity-media .img-frame, .detail-media .img-frame { box-shadow: 0 24px 48px -28px rgba(40,22,10,.55); }
  .lookbook[data-theme="kurogane"] .activity-media .img-frame,
  .lookbook[data-theme="kurogane"] .detail-media .img-frame { box-shadow: 0 24px 50px -26px rgba(0,0,0,.7); }
  /* time numerals tinted toward the accent for warmth */
  .tl-time { color: var(--ink); }
  .tl-meridiem { color: var(--accent-2); }
  /* a hairline accent flourish under the day title */
  .day-title { position: relative; }
  /* next-day affordance: accent fill on hover */
  .stage-next { border-radius: 3px; transition: background .35s, padding .35s; }
  .stage-next:hover { background: var(--chip); padding-inline: 16px; }

  /* ───────────────────────── ALL-SUKHUMVIT DISPLAY TREATMENT ───────────────────────── */
  /* Sans headlines need more weight + tighter tracking to read as premium display. */
  .cover-title, .day-title { font-weight: 700; letter-spacing: -.025em; }
  .activity-title, .detail-title, .stage-next-t { font-weight: 600; letter-spacing: -.015em; }
  .tl-time, .chrome-day-num { font-weight: 600; }
  /* No faux-italic in a sans face — distinguish secondary text by weight + colour instead. */
  .cover-subtitle, .day-sub, .activity-place, .detail-place, .dock-notes,
  .stage-foot-end p, .day-note, .activity-blurb, .detail-blurb { font-style: normal; }
  .cover-subtitle { font-weight: 400; }
  .day-sub { font-weight: 500; color: var(--accent); }
  .activity-place, .detail-place { font-weight: 500; }
  .dock-notes, .stage-foot-end p { font-weight: 400; }
  /* Tracked mini-labels read crisper in Sukhumvit at slightly lighter spacing. */
  .day-label, .activity-kind, .cover-kicker { letter-spacing: .2em; }

  /* ───────────────────────── STEP (logistics) ENTRIES ───────────────────────── */
  .tl-row-step { padding-bottom: clamp(22px, 3.2vh, 40px); }
  .tl-dot-step { width: 9px; height: 9px; top: 8px; border-color: var(--ink-soft); }
  .tl-row-step:hover .tl-dot-step::after { opacity: 1; transform: none; }
  .step { display: grid; grid-template-columns: clamp(48px,5.5vw,62px) minmax(0,1fr);
    gap: clamp(14px,2.2vw,30px); align-items: start; }
  .step-lead { display: flex; flex-direction: column; align-items: center; gap: 9px; padding-top: 1px; }
  .step-time { font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: -.01em;
    font-size: clamp(15px,1.5vw,18px); color: var(--ink-soft); }
  .step-ic { display: grid; place-items: center; width: clamp(38px,4vw,44px); height: clamp(38px,4vw,44px);
    border-radius: 50%; border: 1px solid var(--line); color: var(--accent); flex: none;
    transition: background .35s, border-color .35s, transform .35s; }
  .tl-row-step:hover .step-ic { background: var(--chip); border-color: var(--accent); transform: translateY(-1px); }
  .step-body { min-width: 0; padding-top: 2px; }
  .step-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .step-title { font-weight: 600; letter-spacing: -.01em; line-height: 1.15;
    font-size: calc(clamp(18px,1.9vw,23px) * var(--scale)); }
  .step-kind { font-size: 10px; letter-spacing: .2em; text-transform: uppercase; font-weight: 600; color: var(--accent-2); }
  .step-place { font-size: clamp(13px,1.2vw,14.5px); font-weight: 500; color: var(--ink-soft); margin-top: 6px; }
  .step-note { font-size: clamp(13.5px,1.25vw,15px); line-height: 1.6; color: var(--ink-soft);
    margin-top: 9px; max-width: 54ch; opacity: .9; text-wrap: pretty; }
  .step-dock { margin-top: 13px; }
  .step-dock .dock-chip { padding: 5px 10px; font-size: 10px; }

  /* day date + subtitle */
  .day-date { font-size: clamp(12px,1.1vw,14px); letter-spacing: .08em; font-weight: 500; color: var(--ink-soft); }

  /* per-day weather chip */
  .day-wx { margin-left: auto; display: inline-flex; align-items: center; gap: 11px;
    padding: 7px 15px 7px 12px; border: 1px solid var(--line); border-radius: 100px; background: var(--paper-2); flex: none; }
  .day-wx svg { color: var(--accent); flex: none; }
  .day-wx-temp { font-variant-numeric: tabular-nums; font-weight: 600; font-size: 14px; color: var(--ink); letter-spacing: .02em; }
  .day-wx-lo { color: var(--ink-soft); font-weight: 500; }
  .day-wx-cond { font-size: 12.5px; color: var(--ink-soft); padding-left: 12px; border-left: 1px solid var(--line); white-space: nowrap; }
  @media (max-width: 600px) {
    .day-head-row { flex-wrap: wrap; }
    .day-wx { margin-left: 0; }
    .day-wx-cond { display: none; }
  }
  .day-head .day-sub { font-style: normal; font-weight: 500; color: var(--accent);
    font-size: clamp(16px,1.7vw,21px); margin-top: 12px; }

  /* ───────────────────────── LANGUAGE TOGGLE ───────────────────────── */
  .lang-toggle { display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 100px; overflow: hidden; flex: none; }
  .lang-toggle button { padding: 5px 11px; font-size: 11px; letter-spacing: .08em; font-weight: 600; background: transparent; color: var(--ink-soft); border: none; transition: background .25s, color .25s; }
  .lang-toggle button.on { background: var(--ink); color: var(--paper); }
  .lang-toggle.on-dark { border-color: rgba(246,242,234,.42); }
  .lang-toggle.on-dark button { color: rgba(246,242,234,.78); }
  .lang-toggle.on-dark button.on { background: #f6f2ea; color: #1a1815; }

  /* ───────────────────────── THAI TYPOGRAPHY ───────────────────────── */
  .lookbook[data-lang="th"] .cover-title,
  .lookbook[data-lang="th"] .day-title,
  .lookbook[data-lang="th"] .detail-title,
  .lookbook[data-lang="th"] .activity-title { letter-spacing: normal; line-height: 1.2; }
  .lookbook[data-lang="th"] .cover-subtitle,
  .lookbook[data-lang="th"] .day-sub,
  .lookbook[data-lang="th"] .activity-place,
  .lookbook[data-lang="th"] .detail-place,
  .lookbook[data-lang="th"] .stage-foot-end p,
  .lookbook[data-lang="th"] .dock-notes { font-style: normal; }
  .lookbook[data-lang="th"] .day-note,
  .lookbook[data-lang="th"] .activity-blurb,
  .lookbook[data-lang="th"] .detail-blurb,
  .lookbook[data-lang="th"] .dock-notes { line-height: 1.75; }
  .lookbook[data-lang="th"] .cover-kicker,
  .lookbook[data-lang="th"] .day-label,
  .lookbook[data-lang="th"] .img-kicker,
  .lookbook[data-lang="th"] .dock-chip,
  .lookbook[data-lang="th"] .tl-meridiem,
  .lookbook[data-lang="th"] .chrome-day-name,
  .lookbook[data-lang="th"] .chrome-home,
  .lookbook[data-lang="th"] .chrome-meta,
  .lookbook[data-lang="th"] .detail-time,
  .lookbook[data-lang="th"] .detail-dock-label,
  .lookbook[data-lang="th"] .dock-card-label,
  .lookbook[data-lang="th"] .dock-res-k,
  .lookbook[data-lang="th"] .activity-open,
  .lookbook[data-lang="th"] .step-kind,
  .lookbook[data-lang="th"] .stage-next-k,
  .lookbook[data-lang="th"] .cover-enter,
  .lookbook[data-lang="th"] .cover-dates { letter-spacing: normal; text-transform: none; }
  /* Thai micro-labels need a touch more size + weight to stay crisp */
  .lookbook[data-lang="th"] .dock-chip { font-size: 12px; font-weight: 500; }
  .lookbook[data-lang="th"] .tl-meridiem,
  .lookbook[data-lang="th"] .img-kicker { font-size: 11.5px; }
  .lookbook[data-lang="th"] .day-label,
  .lookbook[data-lang="th"] .detail-time { font-size: 13px; }
  .lookbook[data-lang="th"] .dock-res-k,
  .lookbook[data-lang="th"] .dock-card-label,
  .lookbook[data-lang="th"] .step-kind,
  .lookbook[data-lang="th"] .detail-dock-label { font-size: 12px; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
    .cover-img image-slot { animation: none; }
    .tl-row { opacity: 1; transform: none; }
    .bg-fx .orb { animation: none !important; }
  }
</style>
</head>
<body>
  <div id="root"></div>

  <script src="https://unpkg.com/react@18.3.1/umd/react.development.js" integrity="sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" integrity="sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" integrity="sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y" crossorigin="anonymous"></script>

  <script>
/* BEGIN USAGE */
/**
 * <image-slot> — user-fillable image placeholder.
 *
 * Drop this into a deck, mockup, or page wherever you want the user to
 * supply an image. You control the slot's shape and size; the user fills it
 * by dragging an image file onto it (or clicking to browse). The dropped
 * image persists across reloads via a .image-slots.state.json sidecar —
 * same read-via-fetch / write-via-window.omelette pattern as
 * design_canvas.jsx, so the filled slot shows on share links, downloaded
 * zips, and PPTX export. Outside the omelette runtime the slot is read-only.
 *
 * The host bridge only allows sidecar writes at the project root, so the
 * HTML that uses this component is assumed to live at the project root too
 * (same constraint as design_canvas.jsx).
 *
 * Attributes:
 *   id           Persistence key. REQUIRED for the drop to survive reload —
 *                every slot on the page needs a distinct id.
 *   shape        'rect' | 'rounded' | 'circle' | 'pill'   (default 'rounded')
 *                'circle' applies 50% border-radius; on a non-square slot
 *                that's an ellipse — set equal width and height for a true
 *                circle.
 *   radius       Corner radius in px for 'rounded'.       (default 12)
 *   mask         Any CSS clip-path value. Overrides `shape` — use this for
 *                hexagons, blobs, arbitrary polygons.
 *   fit          object-fit: cover | contain | fill.       (default 'cover')
 *                With cover (the default) double-clicking the filled slot
 *                enters a reframe mode: the whole image spills past the mask
 *                (translucent outside, opaque inside), drag to reposition,
 *                corner-drag to scale. The crop persists alongside the image
 *                in the sidecar. contain/fill stay static.
 *   position     object-position for fit=contain|fill.     (default '50% 50%')
 *   placeholder  Empty-state caption.                      (default 'Drop an image')
 *   src          Optional initial/fallback image URL. A user drop overrides
 *                it; clearing the drop reveals src again.
 *
 * Size and layout come from ordinary CSS on the element — width/height
 * inline or from a parent grid — so it composes with any layout.
 *
 * Usage:
 *   <image-slot id="hero"   style="width:800px;height:450px" shape="rounded" radius="20"
 *               placeholder="Drop a hero image"></image-slot>
 *   <image-slot id="avatar" style="width:120px;height:120px" shape="circle"></image-slot>
 *   <image-slot id="kite"   style="width:300px;height:300px"
 *               mask="polygon(50% 0, 100% 50%, 50% 100%, 0 50%)"></image-slot>
 */
/* END USAGE */

(() => {
  const STATE_FILE = '.image-slots.state.json';
  // 2× a ~600px slot in a 1920-wide deck — retina-sharp without making the
  // sidecar enormous. A 1200px WebP at q=0.85 is ~150-300KB.
  const MAX_DIM = 1200;
  // Raster formats only. SVG is excluded (can carry script; createImageBitmap
  // on SVG blobs is inconsistent). GIF is excluded because the canvas
  // re-encode keeps only the first frame, so an animated GIF would silently
  // go still — better to reject than surprise.
  const ACCEPT = ['image/png', 'image/jpeg', 'image/webp', 'image/avif'];

  // ── Shared sidecar store ────────────────────────────────────────────────
  // One fetch + immediate write-on-change for every <image-slot> on the
  // page. Reads via fetch() so viewing works anywhere the HTML and sidecar
  // are served together; writes go through window.omelette.writeFile, which
  // the host allowlists to *.state.json basenames only.
  const subs = new Set();
  let slots = {};
  // ids explicitly cleared before the sidecar fetch resolved — otherwise
  // the merge below can't tell "never set" from "just deleted" and would
  // resurrect the sidecar's stale value.
  const tombstones = new Set();
  let loaded = false;
  let loadP = null;

  function load() {
    if (loadP) return loadP;
    loadP = fetch(STATE_FILE)
      .then((r) => (r.ok ? r.json() : null))
      .then((j) => {
        // Merge: sidecar loses to any in-memory change that raced ahead of
        // the fetch (drop or clear) so neither is clobbered by hydration.
        if (j && typeof j === 'object') {
          const merged = Object.assign({}, j, slots);
          // A framing-only write that raced ahead of hydration must not
          // drop a user image that's only on disk — inherit u from the
          // sidecar for any in-memory entry that lacks one.
          for (const k in slots) {
            if (merged[k] && !merged[k].u && j[k]) {
              merged[k].u = typeof j[k] === 'string' ? j[k] : j[k].u;
            }
          }
          for (const id of tombstones) delete merged[id];
          slots = merged;
        }
        tombstones.clear();
      })
      .catch(() => {})
      .then(() => { loaded = true; subs.forEach((fn) => fn()); });
    return loadP;
  }

  // Serialize writes so two near-simultaneous drops on different slots
  // can't reorder at the backend and leave the sidecar with only the
  // first. A save requested mid-flight just marks dirty and re-fires on
  // completion with the then-current slots.
  let saving = false;
  let saveDirty = false;
  function save() {
    if (saving) { saveDirty = true; return; }
    const w = window.omelette && window.omelette.writeFile;
    if (!w) return;
    saving = true;
    Promise.resolve(w(STATE_FILE, JSON.stringify(slots)))
      .catch(() => {})
      .then(() => { saving = false; if (saveDirty) { saveDirty = false; save(); } });
  }

  const S_MAX = 5;
  const clampS = (s) => Math.max(1, Math.min(S_MAX, s));

  // Normalize a stored slot value. Pre-reframe sidecars stored a bare
  // data-URL string; newer ones store {u, s, x, y}. Either shape is valid.
  function getSlot(id) {
    const v = slots[id];
    if (!v) return null;
    return typeof v === 'string' ? { u: v, s: 1, x: 0, y: 0 } : v;
  }

  function setSlot(id, val) {
    if (!id) return;
    if (val) { slots[id] = val; tombstones.delete(id); }
    else { delete slots[id]; if (!loaded) tombstones.add(id); }
    subs.forEach((fn) => fn());
    // A drop is rare + high-value — write immediately so nav-away can't lose
    // it. Gate on the initial read so we don't overwrite a sidecar we haven't
    // merged yet; the merge in load() keeps this change once the read lands.
    if (loaded) save(); else load().then(save);
  }

  // ── Image downscale ─────────────────────────────────────────────────────
  // Encode through a canvas so the sidecar carries resized bytes, not the
  // raw upload. Longest side is capped at 2× the slot's rendered width
  // (retina) and at MAX_DIM. WebP keeps alpha and is ~10× smaller than PNG
  // for photos, so there's no need for per-image format picking.
  async function toDataUrl(file, targetW) {
    const bitmap = await createImageBitmap(file);
    try {
      const cap = Math.min(MAX_DIM, Math.max(1, Math.round(targetW * 2)) || MAX_DIM);
      const scale = Math.min(1, cap / Math.max(bitmap.width, bitmap.height));
      const w = Math.max(1, Math.round(bitmap.width * scale));
      const h = Math.max(1, Math.round(bitmap.height * scale));
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      canvas.getContext('2d').drawImage(bitmap, 0, 0, w, h);
      return canvas.toDataURL('image/webp', 0.85);
    } finally {
      bitmap.close && bitmap.close();
    }
  }

  // ── Custom element ──────────────────────────────────────────────────────
  const stylesheet =
    ':host{display:inline-block;position:relative;vertical-align:top;' +
    '  font:13px/1.3 system-ui,-apple-system,sans-serif;color:rgba(0,0,0,.55);width:240px;height:160px}' +
    '.frame{position:absolute;inset:0;overflow:hidden;background:rgba(0,0,0,.04)}' +
    // .frame img (clipped) and .spill (unclipped ghost + handles) share the
    // same left/top/width/height in frame-%, computed by _applyView(), so the
    // inside-mask crop and the outside-mask spill stay pixel-aligned.
    '.frame img{position:absolute;max-width:none;transform:translate(-50%,-50%);' +
    '  -webkit-user-drag:none;user-select:none;touch-action:none}' +
    // Reframe mode (double-click): the full image spills past the mask. The
    // spill layer is sized to the IMAGE bounds so its corners are where the
    // resize handles belong. The ghost <img> inside is translucent; the real
    // clipped <img> underneath shows the opaque in-mask crop.
    '.spill{position:absolute;transform:translate(-50%,-50%);display:none;z-index:1;' +
    '  cursor:grab;touch-action:none}' +
    ':host([data-panning]) .spill{cursor:grabbing}' +
    '.spill .ghost{position:absolute;inset:0;width:100%;height:100%;opacity:.35;' +
    '  pointer-events:none;-webkit-user-drag:none;user-select:none;' +
    '  box-shadow:0 0 0 1px rgba(0,0,0,.2),0 12px 32px rgba(0,0,0,.2)}' +
    '.spill .handle{position:absolute;width:12px;height:12px;border-radius:50%;' +
    '  background:#fff;box-shadow:0 0 0 1.5px #c96442,0 1px 3px rgba(0,0,0,.3);' +
    '  transform:translate(-50%,-50%)}' +
    '.spill .handle[data-c=nw]{left:0;top:0;cursor:nwse-resize}' +
    '.spill .handle[data-c=ne]{left:100%;top:0;cursor:nesw-resize}' +
    '.spill .handle[data-c=sw]{left:0;top:100%;cursor:nesw-resize}' +
    '.spill .handle[data-c=se]{left:100%;top:100%;cursor:nwse-resize}' +
    ':host([data-reframe]){z-index:10}' +
    ':host([data-reframe]) .spill{display:block}' +
    ':host([data-reframe]) .frame{box-shadow:0 0 0 2px #c96442}' +
    '.empty{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;' +
    '  justify-content:center;gap:6px;text-align:center;padding:12px;box-sizing:border-box;' +
    '  cursor:pointer;user-select:none}' +
    '.empty svg{opacity:.45}' +
    '.empty .cap{max-width:90%;font-weight:500;letter-spacing:.01em}' +
    '.empty .sub{font-size:11px}' +
    '.empty .sub u{text-underline-offset:2px;text-decoration-color:rgba(0,0,0,.25)}' +
    '.empty:hover .sub u{color:rgba(0,0,0,.75);text-decoration-color:currentColor}' +
    ':host([data-over]) .frame{outline:2px solid #c96442;outline-offset:-2px;' +
    '  background:rgba(201,100,66,.10)}' +
    '.ring{position:absolute;inset:0;pointer-events:none;border:1.5px dashed rgba(0,0,0,.25);' +
    '  transition:border-color .12s}' +
    ':host([data-over]) .ring{border-color:#c96442}' +
    ':host([data-filled]) .ring{display:none}' +
    // Controls sit BELOW the mask (top:100%), absolutely positioned so the
    // author-declared slot height is unaffected. The gap is padding, not a
    // top offset, so the hover target stays contiguous with the frame.
    '.ctl{position:absolute;top:100%;left:50%;transform:translateX(-50%);padding-top:8px;' +
    '  display:flex;gap:6px;opacity:0;pointer-events:none;transition:opacity .12s;z-index:2;' +
    '  white-space:nowrap}' +
    ':host([data-filled][data-editable]:hover) .ctl,:host([data-reframe]) .ctl' +
    '  {opacity:1;pointer-events:auto}' +
    '.ctl button{appearance:none;border:0;border-radius:6px;padding:5px 10px;cursor:pointer;' +
    '  background:rgba(0,0,0,.65);color:#fff;font:11px/1 system-ui,-apple-system,sans-serif;' +
    '  backdrop-filter:blur(6px)}' +
    '.ctl button:hover{background:rgba(0,0,0,.8)}' +
    '.err{position:absolute;left:8px;bottom:8px;right:8px;color:#b3261e;font-size:11px;' +
    '  background:rgba(255,255,255,.85);padding:4px 6px;border-radius:5px;pointer-events:none}';

  const icon =
    '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
    'stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">' +
    '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>' +
    '<path d="m21 15-5-5L5 21"/></svg>';

  class ImageSlot extends HTMLElement {
    static get observedAttributes() {
      return ['shape', 'radius', 'mask', 'fit', 'position', 'placeholder', 'src', 'id'];
    }

    constructor() {
      super();
      const root = this.attachShadow({ mode: 'open' });
      // .spill and .ctl sit OUTSIDE .frame so overflow:hidden + border-radius
      // on the frame (circle, pill, rounded) can't clip them.
      root.innerHTML =
        '<style>' + stylesheet + '</style>' +
        '<div class="frame" part="frame">' +
        '  <img part="image" alt="" draggable="false" style="display:none">' +
        '  <div class="empty" part="empty">' + icon +
        '    <div class="cap"></div>' +
        '    <div class="sub">or <u>browse files</u></div></div>' +
        '  <div class="ring" part="ring"></div>' +
        '</div>' +
        '<div class="spill">' +
        '  <img class="ghost" alt="" draggable="false">' +
        '  <div class="handle" data-c="nw"></div><div class="handle" data-c="ne"></div>' +
        '  <div class="handle" data-c="sw"></div><div class="handle" data-c="se"></div>' +
        '</div>' +
        '<div class="ctl"><button data-act="replace" title="Replace image">Replace</button>' +
        '  <button data-act="clear" title="Remove image">Remove</button></div>' +
        '<input type="file" accept="' + ACCEPT.join(',') + '" hidden>';
      this._frame = root.querySelector('.frame');
      this._ring = root.querySelector('.ring');
      this._img = root.querySelector('.frame img');
      this._empty = root.querySelector('.empty');
      this._cap = root.querySelector('.cap');
      this._sub = root.querySelector('.sub');
      this._spill = root.querySelector('.spill');
      this._ghost = root.querySelector('.ghost');
      this._err = null;
      this._input = root.querySelector('input');
      this._depth = 0;
      this._gen = 0;
      this._view = { s: 1, x: 0, y: 0 };
      this._subFn = () => this._render();
      // Shadow-DOM listeners live with the shadow DOM — bound once here so
      // disconnect/reconnect (e.g. React remount) doesn't stack handlers.
      this._empty.addEventListener('click', () => this._input.click());
      root.addEventListener('click', (e) => {
        const act = e.target && e.target.getAttribute && e.target.getAttribute('data-act');
        if (act === 'replace') { this._exitReframe(true); this._input.click(); }
        if (act === 'clear') {
          this._exitReframe(false);
          this._gen++;
          this._local = null;
          if (this.id) setSlot(this.id, null); else this._render();
        }
      });
      this._input.addEventListener('change', () => {
        const f = this._input.files && this._input.files[0];
        if (f) this._ingest(f);
        this._input.value = '';
      });
      // naturalWidth/Height aren't known until load — re-apply so the cover
      // baseline is computed from real dimensions, not the 100%×100% fallback.
      this._img.addEventListener('load', () => this._applyView());
      // Gated on editable + fit=cover so share links and contain/fill slots
      // stay static.
      this.addEventListener('dblclick', (e) => {
        if (!this.hasAttribute('data-editable') || !this._reframes()) return;
        e.preventDefault();
        if (this.hasAttribute('data-reframe')) this._exitReframe(true);
        else this._enterReframe();
      });
      // Pan + resize both originate on the spill layer. A handle pointerdown
      // drives an aspect-locked resize anchored at the opposite corner; any
      // other pointerdown on the spill pans. Offsets are frame-% so a
      // reframed slot survives responsive resize / PPTX export.
      this._spill.addEventListener('pointerdown', (e) => {
        if (e.button !== 0 || !this.hasAttribute('data-reframe')) return;
        e.preventDefault();
        e.stopPropagation();
        this._spill.setPointerCapture(e.pointerId);
        const rect = this.getBoundingClientRect();
        const fw = rect.width || 1, fh = rect.height || 1;
        const corner = e.target.getAttribute && e.target.getAttribute('data-c');
        let move;
        if (corner) {
          // Resize about the OPPOSITE corner. Viewport-px throughout (rect
          // fw/fh, not clientWidth) so the math survives a transform:scale()
          // ancestor — deck_stage renders slides scaled-to-fit.
          const iw = this._img.naturalWidth || 1, ih = this._img.naturalHeight || 1;
          const base = Math.max(fw / iw, fh / ih);
          const sx = corner.includes('e') ? 1 : -1;
          const sy = corner.includes('s') ? 1 : -1;
          const s0 = this._view.s;
          const w0 = iw * base * s0, h0 = ih * base * s0;
          const cx0 = (50 + this._view.x) / 100 * fw;
          const cy0 = (50 + this._view.y) / 100 * fh;
          const ox = cx0 - sx * w0 / 2, oy = cy0 - sy * h0 / 2;
          const diag0 = Math.hypot(w0, h0);
          const ux = sx * w0 / diag0, uy = sy * h0 / diag0;
          move = (ev) => {
            const proj = (ev.clientX - rect.left - ox) * ux +
                         (ev.clientY - rect.top - oy) * uy;
            const s = clampS(s0 * proj / diag0);
            const d = diag0 * s / s0;
            this._view.s = s;
            this._view.x = (ox + ux * d / 2) / fw * 100 - 50;
            this._view.y = (oy + uy * d / 2) / fh * 100 - 50;
            this._clampView();
            this._applyView();
          };
        } else {
          this.setAttribute('data-panning', '');
          const start = { px: e.clientX, py: e.clientY, x: this._view.x, y: this._view.y };
          move = (ev) => {
            this._view.x = start.x + (ev.clientX - start.px) / fw * 100;
            this._view.y = start.y + (ev.clientY - start.py) / fh * 100;
            this._clampView();
            this._applyView();
          };
        }
        const up = () => {
          try { this._spill.releasePointerCapture(e.pointerId); } catch {}
          this._spill.removeEventListener('pointermove', move);
          this._spill.removeEventListener('pointerup', up);
          this._spill.removeEventListener('pointercancel', up);
          this.removeAttribute('data-panning');
          this._dragUp = null;
        };
        // Stashed so _exitReframe (Escape / outside-click mid-drag) can
        // tear the capture + listeners down synchronously.
        this._dragUp = up;
        this._spill.addEventListener('pointermove', move);
        this._spill.addEventListener('pointerup', up);
        this._spill.addEventListener('pointercancel', up);
      });
      // Wheel zoom stays available inside reframe mode as a trackpad nicety —
      // zooms toward the cursor (offset' = cursor·(1-k) + offset·k).
      this.addEventListener('wheel', (e) => {
        if (!this.hasAttribute('data-reframe')) return;
        e.preventDefault();
        const r = this.getBoundingClientRect();
        const cx = (e.clientX - r.left) / r.width * 100 - 50;
        const cy = (e.clientY - r.top) / r.height * 100 - 50;
        const prev = this._view.s;
        const next = clampS(prev * Math.pow(1.0015, -e.deltaY));
        if (next === prev) return;
        const k = next / prev;
        this._view.s = next;
        this._view.x = cx * (1 - k) + this._view.x * k;
        this._view.y = cy * (1 - k) + this._view.y * k;
        this._clampView();
        this._applyView();
      }, { passive: false });
    }

    connectedCallback() {
      // Warn once per page — an id-less slot works for the session but
      // cannot persist, and two id-less slots would share nothing.
      if (!this.id && !ImageSlot._warned) {
        ImageSlot._warned = true;
        console.warn('<image-slot> without an id will not persist its dropped image.');
      }
      this.addEventListener('dragenter', this);
      this.addEventListener('dragover', this);
      this.addEventListener('dragleave', this);
      this.addEventListener('drop', this);
      subs.add(this._subFn);
      // width%/height% in _applyView encode the frame aspect at call time —
      // a host resize (responsive grid, pane divider) would stretch the
      // image until the next _render. Re-render on size change: _render()
      // re-seeds _view from stored before clamp/apply, so a shrink→grow
      // cycle round-trips instead of ratcheting x/y toward the narrower
      // frame's clamp range.
      this._ro = new ResizeObserver(() => this._render());
      this._ro.observe(this);
      load();
      this._render();
    }

    disconnectedCallback() {
      subs.delete(this._subFn);
      this.removeEventListener('dragenter', this);
      this.removeEventListener('dragover', this);
      this.removeEventListener('dragleave', this);
      this.removeEventListener('drop', this);
      if (this._ro) { this._ro.disconnect(); this._ro = null; }
      this._exitReframe(false);
    }

    _enterReframe() {
      if (this.hasAttribute('data-reframe')) return;
      this.setAttribute('data-reframe', '');
      this._applyView();
      // Close on click outside (the spill handler stopPropagation()s so
      // in-image drags don't reach this) and on Escape. Listeners are held
      // on the instance so _exitReframe / disconnectedCallback can detach
      // exactly what was attached.
      this._outside = (e) => {
        if (e.composedPath && e.composedPath().includes(this)) return;
        this._exitReframe(true);
      };
      this._esc = (e) => { if (e.key === 'Escape') this._exitReframe(true); };
      document.addEventListener('pointerdown', this._outside, true);
      document.addEventListener('keydown', this._esc, true);
    }

    _exitReframe(commit) {
      if (!this.hasAttribute('data-reframe')) return;
      if (this._dragUp) this._dragUp();
      this.removeAttribute('data-reframe');
      this.removeAttribute('data-panning');
      if (this._outside) document.removeEventListener('pointerdown', this._outside, true);
      if (this._esc) document.removeEventListener('keydown', this._esc, true);
      this._outside = this._esc = null;
      if (commit) this._commitView();
    }

    attributeChangedCallback() { if (this.shadowRoot) this._render(); }

    // handleEvent — one listener object for all four drag events keeps the
    // add/remove symmetric and the depth counter correct.
    handleEvent(e) {
      if (e.type === 'dragenter' || e.type === 'dragover') {
        // Without preventDefault the browser never fires 'drop'.
        e.preventDefault();
        e.stopPropagation();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
        if (e.type === 'dragenter') this._depth++;
        this.setAttribute('data-over', '');
      } else if (e.type === 'dragleave') {
        // dragenter/leave fire for every descendant crossing — count depth
        // so hovering the icon inside the empty state doesn't flicker.
        if (--this._depth <= 0) { this._depth = 0; this.removeAttribute('data-over'); }
      } else if (e.type === 'drop') {
        e.preventDefault();
        e.stopPropagation();
        this._depth = 0;
        this.removeAttribute('data-over');
        const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
        if (f) this._ingest(f);
      }
    }

    async _ingest(file) {
      this._setError(null);
      if (!file || ACCEPT.indexOf(file.type) < 0) {
        this._setError('Drop a PNG, JPEG, WebP, or AVIF image.');
        return;
      }
      // toDataUrl can take hundreds of ms on a large photo. A Clear or a
      // newer drop during that window would be clobbered when this await
      // resumes — bump + capture a generation so stale encodes bail.
      const gen = ++this._gen;
      try {
        const w = this.clientWidth || this.offsetWidth || MAX_DIM;
        const url = await toDataUrl(file, w);
        if (gen !== this._gen) return;
        // Only exit reframe once the new image is in hand — a rejected type
        // or decode failure leaves the in-progress crop untouched.
        this._exitReframe(false);
        const val = { u: url, s: 1, x: 0, y: 0 };
        setSlot(this.id || '', val);
        // Keep a session-local copy for id-less slots so the drop still
        // shows, even though it cannot persist.
        if (!this.id) { this._local = val; this._render(); }
      } catch (err) {
        if (gen !== this._gen) return;
        this._setError('Could not read that image.');
        console.warn('<image-slot> ingest failed:', err);
      }
    }

    _setError(msg) {
      if (this._err) { this._err.remove(); this._err = null; }
      if (!msg) return;
      const d = document.createElement('div');
      d.className = 'err'; d.textContent = msg;
      this.shadowRoot.appendChild(d);
      this._err = d;
      setTimeout(() => { if (this._err === d) { d.remove(); this._err = null; } }, 3000);
    }

    // Reframing (pan/resize) is only meaningful for fit=cover — contain/fill
    // keep the old object-fit path and double-click is a no-op.
    _reframes() {
      return this.hasAttribute('data-filled') &&
        (this.getAttribute('fit') || 'cover') === 'cover';
    }

    // Cover-baseline geometry, shared by clamp/apply/resize. Null until the
    // img has loaded (naturalWidth is 0 before that) or when the slot has no
    // layout box — ResizeObserver fires with a 0×0 rect under display:none,
    // and clamping against a degenerate 1×1 frame would silently pull the
    // stored pan toward zero.
    _geom() {
      const iw = this._img.naturalWidth, ih = this._img.naturalHeight;
      const fw = this.clientWidth, fh = this.clientHeight;
      if (!iw || !ih || !fw || !fh) return null;
      return { iw, ih, fw, fh, base: Math.max(fw / iw, fh / ih) };
    }

    _clampView() {
      // Pan range on each axis is half the overflow past the frame edge.
      const g = this._geom();
      if (!g) return;
      const mx = Math.max(0, (g.iw * g.base * this._view.s / g.fw - 1) * 50);
      const my = Math.max(0, (g.ih * g.base * this._view.s / g.fh - 1) * 50);
      this._view.x = Math.max(-mx, Math.min(mx, this._view.x));
      this._view.y = Math.max(-my, Math.min(my, this._view.y));
    }

    _applyView() {
      const g = this._geom();
      const fit = this.getAttribute('fit') || 'cover';
      if (fit !== 'cover' || !g) {
        // Non-cover, or dimensions not known yet (before img load).
        this._img.style.width = '100%';
        this._img.style.height = '100%';
        this._img.style.left = '50%';
        this._img.style.top = '50%';
        this._img.style.objectFit = fit;
        this._img.style.objectPosition = this.getAttribute('position') || '50% 50%';
        return;
      }
      // Cover baseline: img fills the frame on its tighter axis at s=1, so
      // pan works immediately on the overflowing axis without zooming first.
      // Width/height and left/top are all frame-% — depends only on the
      // frame aspect ratio, so a responsive resize keeps the same crop. The
      // spill layer mirrors the same box so its corners = image corners.
      const k = g.base * this._view.s;
      const w = (g.iw * k / g.fw * 100) + '%';
      const h = (g.ih * k / g.fh * 100) + '%';
      const l = (50 + this._view.x) + '%';
      const t = (50 + this._view.y) + '%';
      this._img.style.width = w; this._img.style.height = h;
      this._img.style.left = l; this._img.style.top = t;
      this._img.style.objectFit = '';
      this._spill.style.width = w; this._spill.style.height = h;
      this._spill.style.left = l; this._spill.style.top = t;
    }

    _commitView() {
      const v = { s: this._view.s, x: this._view.x, y: this._view.y };
      if (this._userUrl) v.u = this._userUrl;
      // Framing-only (no u) persists too so an author-src slot remembers its
      // crop; clearing the sidecar still falls through to src=.
      if (this.id) setSlot(this.id, v);
      else { this._local = v; }
    }

    _render() {
      // Shape / mask. Presets use border-radius so the dashed ring can
      // follow the rounded outline; clip-path is only applied for an
      // explicit `mask` (the ring is hidden there since a rectangle
      // dashed border chopped by an arbitrary polygon looks broken).
      const mask = this.getAttribute('mask');
      const shape = (this.getAttribute('shape') || 'rounded').toLowerCase();
      let radius = '';
      if (shape === 'circle') radius = '50%';
      else if (shape === 'pill') radius = '9999px';
      else if (shape === 'rounded') {
        const n = parseFloat(this.getAttribute('radius'));
        radius = (Number.isFinite(n) ? n : 12) + 'px';
      }
      this._frame.style.borderRadius = mask ? '' : radius;
      this._frame.style.clipPath = mask || '';
      this._ring.style.borderRadius = mask ? '' : radius;
      this._ring.style.display = mask ? 'none' : '';

      // Controls and reframe entry gate on this so share links stay read-only.
      const editable = !!(window.omelette && window.omelette.writeFile);
      this.toggleAttribute('data-editable', editable);
      this._sub.style.display = editable ? '' : 'none';

      // Content. The sidecar is also writable by the agent's write_file
      // tool, so its value isn't guaranteed canvas-originated — only accept
      // data:image/ URLs from it. The `src` attribute is author-controlled
      // (Claude wrote it into the HTML) so it passes through unchanged.
      let stored = this.id ? getSlot(this.id) : this._local;
      if (stored && stored.u && !/^data:image\//i.test(stored.u)) stored = null;
      const srcAttr = this.getAttribute('src') || '';
      this._userUrl = (stored && stored.u) || null;
      const url = this._userUrl || srcAttr;
      // Don't clobber an in-flight reframe with a store-triggered re-render.
      if (!this.hasAttribute('data-reframe')) {
        this._view = {
          s: stored && Number.isFinite(stored.s) ? clampS(stored.s) : 1,
          x: stored && Number.isFinite(stored.x) ? stored.x : 0,
          y: stored && Number.isFinite(stored.y) ? stored.y : 0,
        };
      }
      this._cap.textContent = this.getAttribute('placeholder') || 'Drop an image';
      // Toggle via style.display — the [hidden] attribute alone loses to
      // the display:flex / display:block rules in the stylesheet above.
      if (url) {
        if (this._img.getAttribute('src') !== url) {
          this._img.src = url;
          this._ghost.src = url;
        }
        this._img.style.display = 'block';
        this._empty.style.display = 'none';
        this.setAttribute('data-filled', '');
        this._clampView();
        this._applyView();
      } else {
        this._img.style.display = 'none';
        this._img.removeAttribute('src');
        this._ghost.removeAttribute('src');
        this._empty.style.display = 'flex';
        this.removeAttribute('data-filled');
      }
    }
  }

  if (!customElements.get('image-slot')) {
    customElements.define('image-slot', ImageSlot);
  }
})();

</script>
  <script type="text/babel">

/* BEGIN USAGE */
// tweaks-panel.jsx
// Reusable Tweaks shell + form-control helpers.
// Exports (to window): useTweaks, TweaksPanel, TweakSection, TweakRow, TweakSlider,
//   TweakToggle, TweakRadio, TweakSelect, TweakText, TweakNumber, TweakColor, TweakButton.
//
// Owns the host protocol (listens for __activate_edit_mode / __deactivate_edit_mode,
// posts __edit_mode_available / __edit_mode_set_keys / __edit_mode_dismissed) so
// individual prototypes don't re-roll it. Ships a consistent set of controls so you
// don't hand-draw <input type="range">, segmented radios, steppers, etc.
//
// Usage (in an HTML file that loads React + Babel):
//
//   const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{
//     "primaryColor": "#D97757",
//     "palette": ["#D97757", "#29261b", "#f6f4ef"],
//     "fontSize": 16,
//     "density": "regular",
//     "dark": false
//   }/*EDITMODE-END*/;
//
//   function App() {
//     const [t, setTweak] = useTweaks(TWEAK_DEFAULTS);
//     return (
//       <div style={{ fontSize: t.fontSize, color: t.primaryColor }}>
//         Hello
//         <TweaksPanel>
//           <TweakSection label="Typography" />
//           <TweakSlider label="Font size" value={t.fontSize} min={10} max={32} unit="px"
//                        onChange={(v) => setTweak('fontSize', v)} />
//           <TweakRadio  label="Density" value={t.density}
//                        options={['compact', 'regular', 'comfy']}
//                        onChange={(v) => setTweak('density', v)} />
//           <TweakSection label="Theme" />
//           <TweakColor  label="Primary" value={t.primaryColor}
//                        options={['#D97757', '#2A6FDB', '#1F8A5B', '#7A5AE0']}
//                        onChange={(v) => setTweak('primaryColor', v)} />
//           <TweakColor  label="Palette" value={t.palette}
//                        options={[['#D97757', '#29261b', '#f6f4ef'],
//                                  ['#475569', '#0f172a', '#f1f5f9']]}
//                        onChange={(v) => setTweak('palette', v)} />
//           <TweakToggle label="Dark mode" value={t.dark}
//                        onChange={(v) => setTweak('dark', v)} />
//         </TweaksPanel>
//       </div>
//     );
//   }
//
// TweakRadio is the segmented control for 2–3 short options (auto-falls-back to
// TweakSelect past ~16/~10 chars per label); reach for TweakSelect directly when
// options are many or long. For color tweaks always curate 3-4 options rather than
// a free picker; an option can also be a whole 2–5 color palette (the stored value
// is the array). The Tweak* controls are a floor, not a ceiling — build custom
// controls inside the panel if a tweak calls for UI they don't cover.
/* END USAGE */
// ─────────────────────────────────────────────────────────────────────────────

const __TWEAKS_STYLE = `
  .twk-panel{position:fixed;right:16px;bottom:16px;z-index:2147483646;width:280px;
    max-height:calc(100vh - 32px);display:flex;flex-direction:column;
    transform:scale(var(--dc-inv-zoom,1));transform-origin:bottom right;
    background:rgba(250,249,247,.78);color:#29261b;
    -webkit-backdrop-filter:blur(24px) saturate(160%);backdrop-filter:blur(24px) saturate(160%);
    border:.5px solid rgba(255,255,255,.6);border-radius:14px;
    box-shadow:0 1px 0 rgba(255,255,255,.5) inset,0 12px 40px rgba(0,0,0,.18);
    font:11.5px/1.4 ui-sans-serif,system-ui,-apple-system,sans-serif;overflow:hidden}
  .twk-hd{display:flex;align-items:center;justify-content:space-between;
    padding:10px 8px 10px 14px;cursor:move;user-select:none}
  .twk-hd b{font-size:12px;font-weight:600;letter-spacing:.01em}
  .twk-x{appearance:none;border:0;background:transparent;color:rgba(41,38,27,.55);
    width:22px;height:22px;border-radius:6px;cursor:default;font-size:13px;line-height:1}
  .twk-x:hover{background:rgba(0,0,0,.06);color:#29261b}
  .twk-body{padding:2px 14px 14px;display:flex;flex-direction:column;gap:10px;
    overflow-y:auto;overflow-x:hidden;min-height:0;
    scrollbar-width:thin;scrollbar-color:rgba(0,0,0,.15) transparent}
  .twk-body::-webkit-scrollbar{width:8px}
  .twk-body::-webkit-scrollbar-track{background:transparent;margin:2px}
  .twk-body::-webkit-scrollbar-thumb{background:rgba(0,0,0,.15);border-radius:4px;
    border:2px solid transparent;background-clip:content-box}
  .twk-body::-webkit-scrollbar-thumb:hover{background:rgba(0,0,0,.25);
    border:2px solid transparent;background-clip:content-box}
  .twk-row{display:flex;flex-direction:column;gap:5px}
  .twk-row-h{flex-direction:row;align-items:center;justify-content:space-between;gap:10px}
  .twk-lbl{display:flex;justify-content:space-between;align-items:baseline;
    color:rgba(41,38,27,.72)}
  .twk-lbl>span:first-child{font-weight:500}
  .twk-val{color:rgba(41,38,27,.5);font-variant-numeric:tabular-nums}

  .twk-sect{font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
    color:rgba(41,38,27,.45);padding:10px 0 0}
  .twk-sect:first-child{padding-top:0}

  .twk-field{appearance:none;box-sizing:border-box;width:100%;min-width:0;height:26px;padding:0 8px;
    border:.5px solid rgba(0,0,0,.1);border-radius:7px;
    background:rgba(255,255,255,.6);color:inherit;font:inherit;outline:none}
  .twk-field:focus{border-color:rgba(0,0,0,.25);background:rgba(255,255,255,.85)}
  select.twk-field{padding-right:22px;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path fill='rgba(0,0,0,.5)' d='M0 0h10L5 6z'/></svg>");
    background-repeat:no-repeat;background-position:right 8px center}

  .twk-slider{appearance:none;-webkit-appearance:none;width:100%;height:4px;margin:6px 0;
    border-radius:999px;background:rgba(0,0,0,.12);outline:none}
  .twk-slider::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;
    width:14px;height:14px;border-radius:50%;background:#fff;
    border:.5px solid rgba(0,0,0,.12);box-shadow:0 1px 3px rgba(0,0,0,.2);cursor:default}
  .twk-slider::-moz-range-thumb{width:14px;height:14px;border-radius:50%;
    background:#fff;border:.5px solid rgba(0,0,0,.12);box-shadow:0 1px 3px rgba(0,0,0,.2);cursor:default}

  .twk-seg{position:relative;display:flex;padding:2px;border-radius:8px;
    background:rgba(0,0,0,.06);user-select:none}
  .twk-seg-thumb{position:absolute;top:2px;bottom:2px;border-radius:6px;
    background:rgba(255,255,255,.9);box-shadow:0 1px 2px rgba(0,0,0,.12);
    transition:left .15s cubic-bezier(.3,.7,.4,1),width .15s}
  .twk-seg.dragging .twk-seg-thumb{transition:none}
  .twk-seg button{appearance:none;position:relative;z-index:1;flex:1;border:0;
    background:transparent;color:inherit;font:inherit;font-weight:500;min-height:22px;
    border-radius:6px;cursor:default;padding:4px 6px;line-height:1.2;
    overflow-wrap:anywhere}

  .twk-toggle{position:relative;width:32px;height:18px;border:0;border-radius:999px;
    background:rgba(0,0,0,.15);transition:background .15s;cursor:default;padding:0}
  .twk-toggle[data-on="1"]{background:#34c759}
  .twk-toggle i{position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;
    background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.25);transition:transform .15s}
  .twk-toggle[data-on="1"] i{transform:translateX(14px)}

  .twk-num{display:flex;align-items:center;box-sizing:border-box;min-width:0;height:26px;padding:0 0 0 8px;
    border:.5px solid rgba(0,0,0,.1);border-radius:7px;background:rgba(255,255,255,.6)}
  .twk-num-lbl{font-weight:500;color:rgba(41,38,27,.6);cursor:ew-resize;
    user-select:none;padding-right:8px}
  .twk-num input{flex:1;min-width:0;height:100%;border:0;background:transparent;
    font:inherit;font-variant-numeric:tabular-nums;text-align:right;padding:0 8px 0 0;
    outline:none;color:inherit;-moz-appearance:textfield}
  .twk-num input::-webkit-inner-spin-button,.twk-num input::-webkit-outer-spin-button{
    -webkit-appearance:none;margin:0}
  .twk-num-unit{padding-right:8px;color:rgba(41,38,27,.45)}

  .twk-btn{appearance:none;height:26px;padding:0 12px;border:0;border-radius:7px;
    background:rgba(0,0,0,.78);color:#fff;font:inherit;font-weight:500;cursor:default}
  .twk-btn:hover{background:rgba(0,0,0,.88)}
  .twk-btn.secondary{background:rgba(0,0,0,.06);color:inherit}
  .twk-btn.secondary:hover{background:rgba(0,0,0,.1)}

  .twk-swatch{appearance:none;-webkit-appearance:none;width:56px;height:22px;
    border:.5px solid rgba(0,0,0,.1);border-radius:6px;padding:0;cursor:default;
    background:transparent;flex-shrink:0}
  .twk-swatch::-webkit-color-swatch-wrapper{padding:0}
  .twk-swatch::-webkit-color-swatch{border:0;border-radius:5.5px}
  .twk-swatch::-moz-color-swatch{border:0;border-radius:5.5px}

  .twk-chips{display:flex;gap:6px}
  .twk-chip{position:relative;appearance:none;flex:1;min-width:0;height:46px;
    padding:0;border:0;border-radius:6px;overflow:hidden;cursor:default;
    box-shadow:0 0 0 .5px rgba(0,0,0,.12),0 1px 2px rgba(0,0,0,.06);
    transition:transform .12s cubic-bezier(.3,.7,.4,1),box-shadow .12s}
  .twk-chip:hover{transform:translateY(-1px);
    box-shadow:0 0 0 .5px rgba(0,0,0,.18),0 4px 10px rgba(0,0,0,.12)}
  .twk-chip[data-on="1"]{box-shadow:0 0 0 1.5px rgba(0,0,0,.85),
    0 2px 6px rgba(0,0,0,.15)}
  .twk-chip>span{position:absolute;top:0;bottom:0;right:0;width:34%;
    display:flex;flex-direction:column;box-shadow:-1px 0 0 rgba(0,0,0,.1)}
  .twk-chip>span>i{flex:1;box-shadow:0 -1px 0 rgba(0,0,0,.1)}
  .twk-chip>span>i:first-child{box-shadow:none}
  .twk-chip svg{position:absolute;top:6px;left:6px;width:13px;height:13px;
    filter:drop-shadow(0 1px 1px rgba(0,0,0,.3))}
`;

// ── useTweaks ───────────────────────────────────────────────────────────────
// Single source of truth for tweak values. setTweak persists via the host
// (__edit_mode_set_keys → host rewrites the EDITMODE block on disk).
function useTweaks(defaults) {
  const [values, setValues] = React.useState(defaults);
  // Accepts either setTweak('key', value) or setTweak({ key: value, ... }) so a
  // useState-style call doesn't write a "[object Object]" key into the persisted
  // JSON block.
  const setTweak = React.useCallback((keyOrEdits, val) => {
    const edits = typeof keyOrEdits === 'object' && keyOrEdits !== null
      ? keyOrEdits : { [keyOrEdits]: val };
    setValues((prev) => ({ ...prev, ...edits }));
    window.parent.postMessage({ type: '__edit_mode_set_keys', edits }, '*');
    // Same-window signal so in-page listeners (deck-stage rail thumbnails)
    // can react — the parent message only reaches the host, not peers.
    window.dispatchEvent(new CustomEvent('tweakchange', { detail: edits }));
  }, []);
  return [values, setTweak];
}

// ── TweaksPanel ─────────────────────────────────────────────────────────────
// Floating shell. Registers the protocol listener BEFORE announcing
// availability — if the announce ran first, the host's activate could land
// before our handler exists and the toolbar toggle would silently no-op.
// The close button posts __edit_mode_dismissed so the host's toolbar toggle
// flips off in lockstep; the host echoes __deactivate_edit_mode back which
// is what actually hides the panel.
function TweaksPanel({ title = 'Tweaks', children }) {
  const [open, setOpen] = React.useState(false);
  const dragRef = React.useRef(null);
  const offsetRef = React.useRef({ x: 16, y: 16 });
  const PAD = 16;

  const clampToViewport = React.useCallback(() => {
    const panel = dragRef.current;
    if (!panel) return;
    const w = panel.offsetWidth, h = panel.offsetHeight;
    const maxRight = Math.max(PAD, window.innerWidth - w - PAD);
    const maxBottom = Math.max(PAD, window.innerHeight - h - PAD);
    offsetRef.current = {
      x: Math.min(maxRight, Math.max(PAD, offsetRef.current.x)),
      y: Math.min(maxBottom, Math.max(PAD, offsetRef.current.y)),
    };
    panel.style.right = offsetRef.current.x + 'px';
    panel.style.bottom = offsetRef.current.y + 'px';
  }, []);

  React.useEffect(() => {
    if (!open) return;
    clampToViewport();
    if (typeof ResizeObserver === 'undefined') {
      window.addEventListener('resize', clampToViewport);
      return () => window.removeEventListener('resize', clampToViewport);
    }
    const ro = new ResizeObserver(clampToViewport);
    ro.observe(document.documentElement);
    return () => ro.disconnect();
  }, [open, clampToViewport]);

  React.useEffect(() => {
    const onMsg = (e) => {
      const t = e?.data?.type;
      if (t === '__activate_edit_mode') setOpen(true);
      else if (t === '__deactivate_edit_mode') setOpen(false);
    };
    window.addEventListener('message', onMsg);
    window.parent.postMessage({ type: '__edit_mode_available' }, '*');
    return () => window.removeEventListener('message', onMsg);
  }, []);

  const dismiss = () => {
    setOpen(false);
    window.parent.postMessage({ type: '__edit_mode_dismissed' }, '*');
  };

  const onDragStart = (e) => {
    const panel = dragRef.current;
    if (!panel) return;
    const r = panel.getBoundingClientRect();
    const sx = e.clientX, sy = e.clientY;
    const startRight = window.innerWidth - r.right;
    const startBottom = window.innerHeight - r.bottom;
    const move = (ev) => {
      offsetRef.current = {
        x: startRight - (ev.clientX - sx),
        y: startBottom - (ev.clientY - sy),
      };
      clampToViewport();
    };
    const up = () => {
      window.removeEventListener('mousemove', move);
      window.removeEventListener('mouseup', up);
    };
    window.addEventListener('mousemove', move);
    window.addEventListener('mouseup', up);
  };

  if (!open) return null;
  return (
    <>
      <style>{__TWEAKS_STYLE}</style>
      <div ref={dragRef} className="twk-panel" data-omelette-chrome=""
           style={{ right: offsetRef.current.x, bottom: offsetRef.current.y }}>
        <div className="twk-hd" onMouseDown={onDragStart}>
          <b>{title}</b>
          <button className="twk-x" aria-label="Close tweaks"
                  onMouseDown={(e) => e.stopPropagation()}
                  onClick={dismiss}>✕</button>
        </div>
        <div className="twk-body">
          {children}
        </div>
      </div>
    </>
  );
}

// ── Layout helpers ──────────────────────────────────────────────────────────

function TweakSection({ label, children }) {
  return (
    <>
      <div className="twk-sect">{label}</div>
      {children}
    </>
  );
}

function TweakRow({ label, value, children, inline = false }) {
  return (
    <div className={inline ? 'twk-row twk-row-h' : 'twk-row'}>
      <div className="twk-lbl">
        <span>{label}</span>
        {value != null && <span className="twk-val">{value}</span>}
      </div>
      {children}
    </div>
  );
}

// ── Controls ────────────────────────────────────────────────────────────────

function TweakSlider({ label, value, min = 0, max = 100, step = 1, unit = '', onChange }) {
  return (
    <TweakRow label={label} value={`${value}${unit}`}>
      <input type="range" className="twk-slider" min={min} max={max} step={step}
             value={value} onChange={(e) => onChange(Number(e.target.value))} />
    </TweakRow>
  );
}

function TweakToggle({ label, value, onChange }) {
  return (
    <div className="twk-row twk-row-h">
      <div className="twk-lbl"><span>{label}</span></div>
      <button type="button" className="twk-toggle" data-on={value ? '1' : '0'}
              role="switch" aria-checked={!!value}
              onClick={() => onChange(!value)}><i /></button>
    </div>
  );
}

function TweakRadio({ label, value, options, onChange }) {
  const trackRef = React.useRef(null);
  const [dragging, setDragging] = React.useState(false);
  // The active value is read by pointer-move handlers attached for the lifetime
  // of a drag — ref it so a stale closure doesn't fire onChange for every move.
  const valueRef = React.useRef(value);
  valueRef.current = value;

  // Segments wrap mid-word once per-segment width runs out. The track is
  // ~248px (280 panel − 28 body pad − 4 seg pad), each button loses 12px
  // to its own padding, and 11.5px system-ui averages ~6.3px/char — so 2
  // options fit ~16 chars each, 3 fit ~10. Past that (or >3 options), fall
  // back to a dropdown rather than wrap.
  const labelLen = (o) => String(typeof o === 'object' ? o.label : o).length;
  const maxLen = options.reduce((m, o) => Math.max(m, labelLen(o)), 0);
  const fitsAsSegments = maxLen <= ({ 2: 16, 3: 10 }[options.length] ?? 0);
  if (!fitsAsSegments) {
    // <select> emits strings — map back to the original option value so the
    // fallback stays type-preserving (numbers, booleans) like the segment path.
    const resolve = (s) => {
      const m = options.find((o) => String(typeof o === 'object' ? o.value : o) === s);
      return m === undefined ? s : typeof m === 'object' ? m.value : m;
    };
    return <TweakSelect label={label} value={value} options={options}
                        onChange={(s) => onChange(resolve(s))} />;
  }
  const opts = options.map((o) => (typeof o === 'object' ? o : { value: o, label: o }));
  const idx = Math.max(0, opts.findIndex((o) => o.value === value));
  const n = opts.length;

  const segAt = (clientX) => {
    const r = trackRef.current.getBoundingClientRect();
    const inner = r.width - 4;
    const i = Math.floor(((clientX - r.left - 2) / inner) * n);
    return opts[Math.max(0, Math.min(n - 1, i))].value;
  };

  const onPointerDown = (e) => {
    setDragging(true);
    const v0 = segAt(e.clientX);
    if (v0 !== valueRef.current) onChange(v0);
    const move = (ev) => {
      if (!trackRef.current) return;
      const v = segAt(ev.clientX);
      if (v !== valueRef.current) onChange(v);
    };
    const up = () => {
      setDragging(false);
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
    };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
  };

  return (
    <TweakRow label={label}>
      <div ref={trackRef} role="radiogroup" onPointerDown={onPointerDown}
           className={dragging ? 'twk-seg dragging' : 'twk-seg'}>
        <div className="twk-seg-thumb"
             style={{ left: `calc(2px + ${idx} * (100% - 4px) / ${n})`,
                      width: `calc((100% - 4px) / ${n})` }} />
        {opts.map((o) => (
          <button key={o.value} type="button" role="radio" aria-checked={o.value === value}>
            {o.label}
          </button>
        ))}
      </div>
    </TweakRow>
  );
}

function TweakSelect({ label, value, options, onChange }) {
  return (
    <TweakRow label={label}>
      <select className="twk-field" value={value} onChange={(e) => onChange(e.target.value)}>
        {options.map((o) => {
          const v = typeof o === 'object' ? o.value : o;
          const l = typeof o === 'object' ? o.label : o;
          return <option key={v} value={v}>{l}</option>;
        })}
      </select>
    </TweakRow>
  );
}

function TweakText({ label, value, placeholder, onChange }) {
  return (
    <TweakRow label={label}>
      <input className="twk-field" type="text" value={value} placeholder={placeholder}
             onChange={(e) => onChange(e.target.value)} />
    </TweakRow>
  );
}

function TweakNumber({ label, value, min, max, step = 1, unit = '', onChange }) {
  const clamp = (n) => {
    if (min != null && n < min) return min;
    if (max != null && n > max) return max;
    return n;
  };
  const startRef = React.useRef({ x: 0, val: 0 });
  const onScrubStart = (e) => {
    e.preventDefault();
    startRef.current = { x: e.clientX, val: value };
    const decimals = (String(step).split('.')[1] || '').length;
    const move = (ev) => {
      const dx = ev.clientX - startRef.current.x;
      const raw = startRef.current.val + dx * step;
      const snapped = Math.round(raw / step) * step;
      onChange(clamp(Number(snapped.toFixed(decimals))));
    };
    const up = () => {
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
    };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
  };
  return (
    <div className="twk-num">
      <span className="twk-num-lbl" onPointerDown={onScrubStart}>{label}</span>
      <input type="number" value={value} min={min} max={max} step={step}
             onChange={(e) => onChange(clamp(Number(e.target.value)))} />
      {unit && <span className="twk-num-unit">{unit}</span>}
    </div>
  );
}

// Relative-luminance contrast pick — checkmarks drawn over a swatch need to
// read on both #111 and #fafafa without per-option configuration. Hex input
// only (#rgb / #rrggbb); named or rgb()/hsl() colors fall through to "light".
function __twkIsLight(hex) {
  const h = String(hex).replace('#', '');
  const x = h.length === 3 ? h.replace(/./g, (c) => c + c) : h.padEnd(6, '0');
  const n = parseInt(x.slice(0, 6), 16);
  if (Number.isNaN(n)) return true;
  const r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
  return r * 299 + g * 587 + b * 114 > 148000;
}

const __TwkCheck = ({ light }) => (
  <svg viewBox="0 0 14 14" aria-hidden="true">
    <path d="M3 7.2 5.8 10 11 4.2" fill="none" strokeWidth="2.2"
          strokeLinecap="round" strokeLinejoin="round"
          stroke={light ? 'rgba(0,0,0,.78)' : '#fff'} />
  </svg>
);

// TweakColor — curated color/palette picker. Each option is either a single
// hex string or an array of 1-5 hex strings; the card adapts — a lone color
// renders solid, a palette renders colors[0] as the hero (left ~2/3) with the
// rest stacked in a sharp column on the right. onChange emits the
// option in the shape it was passed (string stays string, array stays array).
// Without options it falls back to the native color input for back-compat.
function TweakColor({ label, value, options, onChange }) {
  if (!options || !options.length) {
    return (
      <div className="twk-row twk-row-h">
        <div className="twk-lbl"><span>{label}</span></div>
        <input type="color" className="twk-swatch" value={value}
               onChange={(e) => onChange(e.target.value)} />
      </div>
    );
  }
  // Native <input type=color> emits lowercase hex per the HTML spec, so
  // compare case-insensitively. String() guards JSON.stringify(undefined),
  // which returns the primitive undefined (no .toLowerCase).
  const key = (o) => String(JSON.stringify(o)).toLowerCase();
  const cur = key(value);
  return (
    <TweakRow label={label}>
      <div className="twk-chips" role="radiogroup">
        {options.map((o, i) => {
          const colors = Array.isArray(o) ? o : [o];
          const [hero, ...rest] = colors;
          const sup = rest.slice(0, 4);
          const on = key(o) === cur;
          return (
            <button key={i} type="button" className="twk-chip" role="radio"
                    aria-checked={on} data-on={on ? '1' : '0'}
                    aria-label={colors.join(', ')} title={colors.join(' · ')}
                    style={{ background: hero }}
                    onClick={() => onChange(o)}>
              {sup.length > 0 && (
                <span>
                  {sup.map((c, j) => <i key={j} style={{ background: c }} />)}
                </span>
              )}
              {on && <__TwkCheck light={__twkIsLight(hero)} />}
            </button>
          );
        })}
      </div>
    </TweakRow>
  );
}

function TweakButton({ label, onClick, secondary = false }) {
  return (
    <button type="button" className={secondary ? 'twk-btn secondary' : 'twk-btn'}
            onClick={onClick}>{label}</button>
  );
}

Object.assign(window, {
  useTweaks, TweaksPanel, TweakSection, TweakRow,
  TweakSlider, TweakToggle, TweakRadio, TweakSelect,
  TweakText, TweakNumber, TweakColor, TweakButton,
});

</script>
