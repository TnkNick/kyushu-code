function Icon({ name, size = 18, stroke = 1.25, style, className }) {
  const inner = ICON_PATHS[name] || null;
  return (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth={stroke}
      strokeLinecap="round"
      strokeLinejoin="round"
      className={className}
      style={{ display: 'block', flexShrink: 0, ...style }}
      aria-hidden="true"
    >
      {inner}
    </svg>
  );
}

Object.assign(window, { Icon, ICON_PATHS });

